  "QuizGamePage.xaml": {
    "QuizTitle": "Hip-Hop Facts",
    "HipHopFacts": [
      {
        "Fact": "False",
        "Title": "Wu-Tan Clan",
        "Url": "https://ideogram.ai/api/images/direct/oUY7c25NSy6ard-6VtdLIQ.png",
        "Description": "Contrary to common belief, the influential hip hop group Wu-Tang Clan originated from Staten Island, New York City, not from Los Angeles."
      },
      {
        "Fact": "True",
        "Title": "Gangsta Rap",
        "Url": "https://ideogram.ai/api/images/direct/8Nu4KuayQRK3tkryHJgmDg.png",
        "Description": "The 90s witnessed the emergence of West Coast gangsta rap with artists like Dr. Dre and Snoop Dogg, defining the genre with their smooth yet hardcore sound."
      },
      {
        "Fact": "True",
        "Title": "Poetic Rap",
        "Url": "https://ideogram.ai/api/images/direct/0CkQDU5PSqiiPIh2MsKm0w.png",
        "Description": "East Coast hip hop flourished in the 90s, with acts like Notorious B.I.G. and Nas gaining fame for their intricate storytelling and poetic verses."
      },
      {
        "Fact": "True",
        "Title": "Hip Hop Females",
        "Url": "https://ideogram.ai/api/images/direct/Jjs3jHosRmK1rJwyYGSy9Q.png",
        "Description": "Female MCs like Queen Latifah and Lauryn Hill broke barriers in the male-dominated hip hop scene of the 90s, showcasing diverse perspectives and lyrical prowess."
      },
      {
        "Fact": "False",
        "Title": "Sampling",
        "Url": "https://ideogram.ai/api/images/direct/-PE7HtVmRL-NsYGUozjnLw.jpg",
        "Description": "In the 90s, hip hop artists faced no legal challenges or controversies regarding sampling, and they freely sampled music without any copyright concerns."
      },
      {
        "Fact": "False",
        "Title": "Hip Hop Fashion",
        "Url": "https://ideogram.ai/api/images/direct/uRAdKCnrS3yxnTCoS-8I-A.png",
        "Description": "Baggy clothing was not a significant trend in 90s hip hop fashion, with most artists opting for tight-fitting attire."
      },
      {
        "Fact": "True",
        "Title": "East vs West",
        "Url": "https://ideogram.ai/api/images/direct/kYFrxN_GTsK92jtUYDtyNg.png",
        "Description": "The beef between East Coast and West Coast hip hop escalated in the 90s, culminating tragically in the deaths of Tupac Shakur and The Notorious B.I.G."
      },
      {
        "Fact": "True",
        "Title": "Mainstream Artist",
        "Url": "https://ideogram.ai/api/images/direct/gI_AULLnRvieqCNkgCugfw.png",
        "Description": "The 90s saw the commercialization of hip hop, with artists like MC Hammer and Vanilla Ice achieving mainstream success but facing criticism for their perceived lack of authenticity."
      },
      {
        "Fact": "True",
        "Title": "Independent Labels",
        "Url": "https://ideogram.ai/api/images/direct/CNX-p2E3TLWpAAVnumiG2w.png",
        "Description": "The 90s hip hop scene fostered the growth of independent record labels like Def Jam and Bad Boy Records, providing platforms for emerging artists and shaping the industry's landscape."
      },
      {
        "Fact": "False",
        "Title": "Culture Influence",
        "Url": "https://ideogram.ai/api/images/direct/xo6V81bhQped75I31O37yA.jpg",
        "Description": "In the 90s, hip hop culture had minimal influence on mainstream media, fashion, and language, remaining largely confined to underground circles."
      }
    ]
