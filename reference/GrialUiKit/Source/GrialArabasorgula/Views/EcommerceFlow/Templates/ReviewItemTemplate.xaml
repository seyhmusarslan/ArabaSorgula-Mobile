<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ReviewItemTemplate">
    <grial:CardView
        Margin="{ DynamicResource AirSpacingSmallBorder }"
        RowSpacing="8"
        Padding="20"
        RowDefinitions="20,Auto,4,Auto,Auto"
        HasShadow="False">

        <!-- STARS -->
        <local:RatingLabel
            Grid.Row="0"
            Value="{ Binding RatingValue }"
        />

        <!-- TITLE -->
        <Label
            Grid.Row="1"
            Text="{ Binding Title }"
            FontSize="14"
            HorizontalOptions="Start"
        />

        <!-- DATE -->
        <Label
            Grid.Row="1"
            Text="{ Binding Date }"
            FontSize="14"
            Opacity=".5"
            HorizontalOptions="End"
        />

        <!-- SEPARATOR -->
        <BoxView
            Grid.Row="2"
            Margin="{ DynamicResource RemoveParentAirSpacing }"
            VerticalOptions="Center"
            Color="{ DynamicResource ListSeparatorColor }"
            HeightRequest="1"
        />

        <!-- COMMENT TEXT -->
        <Label
            Grid.Row="3"
            FontSize="13"
            Text="{ Binding Comment }"
            TextColor="{ DynamicResource TextSecondaryColor }"
        />

        <!-- REVIEWER -->
        <Label
            Grid.Row="4"
            FontSize="13"
            Text="{ Binding Reviewer }"
            TextColor="{ DynamicResource PrimaryColor }"
            HorizontalOptions="Start"
        />
    </grial:CardView>
</ContentView>
