<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ProductPurchaseCardTemplate">
    <Grid
        HeightRequest="120"
        ColumnSpacing="0"
        ColumnDefinitions="120,*">

        <!-- PRODUCT IMAGE -->
        <!--
            TODO: removed
            grial:Effects.CornerRadius="0,20,0,20"
            from image as couldn't find why is there
        -->
        <Image Source="{ Binding Product.Image }" />

        <!-- PRODUCT DATA -->
        <Grid
            Grid.Column="1"
            Padding="16,16"
            RowSpacing="4"
            BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
            RowDefinitions="Auto,Auto,Auto,Auto">
            <!-- PRODUCT NAME -->
            <Label
                Grid.Row="1"
                Margin="0,5,0,0"
                LineBreakMode="TailTruncation"
                Text="{ Binding Product.Name }"
                FontSize="18"
                HorizontalOptions="Start"
                TextColor="{ DynamicResource TextColor }"
            />

            <!-- MANUFACTURER -->
            <Label
                Grid.Row="0"
                Text="{ Binding Product.Manufacturer, StringFormat='BY {0}' }"
                FontSize="11"
                HorizontalOptions="Start"
                TextColor="{ DynamicResource PrimaryColor }"
            />

            <!-- PRICE -->
            <Label
                Padding="0,8,0,0"
                Grid.Row="2"
                Text="{ Binding Product.Price, StringFormat='$ {0:0.##.}' }"
                FontSize="{ OnIdiom
                    Phone=20,
                    Tablet=24
                }"
                HorizontalOptions="Start"
                TextColor="{ DynamicResource SuccessColor }"
            />

        </Grid>
    </Grid>
</ContentView>
