<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.TimelineItemTemplate">
    <Grid
        ColumnSpacing="14"
        RowSpacing="0"
        Padding="20,0,10,0"
        RowDefinitions="Auto"
        VerticalOptions="Center"
        ColumnDefinitions="Auto,*">

        <!-- VERTICAL LINE -->
        <BoxView
            Margin="0,-10"
            WidthRequest="2"
            VerticalOptions="Fill"
            HorizontalOptions="Center"
            Color="{ DynamicResource BackgroundSecondaryColor }"
        />

        <!-- BG -->
        <BoxView
            Grid.Column="1"
            Margin="0,10"
            Color="{ DynamicResource BackgroundSecondaryColor }"
            CornerRadius="{ DynamicResource BaseCornerRadius }"
            VerticalOptions="Fill"
            HorizontalOptions="Fill"
        />

        <grial:CircleImage
            Size="50"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            BorderColor="{ DynamicResource BackgroundSecondaryColor }"
            BorderSize="1"
            Source="{ Binding Image }"
        />

        <!-- BODY -->
        <Grid
            Grid.Column="1"
            VerticalOptions="Center"
            Padding="20"
            RowDefinitions="Auto,Auto,15">
            <!-- TITLE -->
            <Label
                Text="{ Binding EventTitle }"
                FontAttributes="None"
                TextColor="{ DynamicResource TextColor }"
            />
            <!-- TEXT -->
            <Label
                Grid.Row="1"
                Text="{ Binding EventDescription }"
                TextColor="{ DynamicResource TextSecondaryColor }"
                FontSize="{ StaticResource SmallFontSize }"
                MaxLines="3 "
            />
            <!-- WHEN -->
            <Label
                Grid.Row="2"
                Text="{ Binding When }"
                FontAttributes="None"
                FontSize="{ StaticResource SmallFontSize }"
                TextColor="{ DynamicResource PrimaryColor }"
            />
        </Grid>
    </Grid>
</ContentView>
