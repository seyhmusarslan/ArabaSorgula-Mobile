<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.TimelinePage"
    Title="{ grial:Translate PageTitleTimeline }"
    BackgroundColor="{ DynamicResource BackgroundColor }">
    <CollectionView ItemsSource="{ Binding TimelineList }">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <local:TimelineItemTemplate Padding="{ StaticResource MainWrapperPadding }" />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
