<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="arabasorgula.ProductItemViewItemTemplate"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula">

    <ContentView.Resources>
        <ResourceDictionary Source="/Styles/AnimationResources.xaml" />

        <ControlTemplate x:Key="CheckboxHeartTemplate">
            <Grid>
                <Grid x:Name="Unchecked">
                    <Label
                        Opacity=".5"
                        Style="{ DynamicResource FontIcon }"
                        Text="{ x:Static local:GrialIconsFont.Heart }"
                        FontSize="{ TemplateBinding IconFontSize }"
                        TextColor="{ DynamicResource FavoriteColor }"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                    />
                </Grid>

                <Grid x:Name="Checked">
                    <Label
                        Style="{ DynamicResource FontIconFill }"
                        Text="{ x:Static local:GrialIconsFont.Heart }"
                        TextColor="{ DynamicResource FavoriteColor }"
                        FontSize="{ TemplateBinding IconFontSize }"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                    />
                </Grid>
            </Grid>

        </ControlTemplate>
    </ContentView.Resources>

    <ContentView.Content>
        <Grid
            RowSpacing="0"
            VerticalOptions="Fill"
            RowDefinitions="6*,4*,Auto">

            <!-- PRODUCT IMAGE -->
            <Image
                Grid.Row="0"
                Source="{ Binding Product.Image }"
                Aspect="AspectFill">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnImageTapped" />
                </Image.GestureRecognizers>
            </Image>

            <!-- PRODUCT INFO -->
            <grial:ExtendedGrid
                BackgroundColor="Transparent"
                Grid.Row="1"
                Padding="{ DynamicResource AirSpacing }"
                VerticalOptions="Start"
                RowSpacing="5"
                grial:Effects.ApplyIOSSafeAreaAsPadding="Left,Right"
                RowDefinitions="Auto,Auto,*"
                Margin="0,-40,0,0"
                TrimTopShape="InvertedRoundedCorners"
                TrimTopHeight="40">

                <!-- MANUFACTURER -->
                <Label
                    Grid.Row="0"
                    Text="{ Binding Product.Manufacturer, StringFormat='By {0:F0}' }"
                    FontAttributes="Bold"
                    TextTransform="Uppercase"
                    FontSize="{ OnIdiom
                        Phone={StaticResource BaseFontSize},
                        Tablet={StaticResource SmallTitleFontSize}
                    }"
                    HorizontalOptions="Start"
                    TextColor="{ DynamicResource PrimaryColor }"
                />

                <!-- PRODUCT NAME -->
                <Label
                    Grid.Row="1"
                    Text="{ Binding Product.Name }"
                    FontSize="{ OnIdiom
                        Phone={StaticResource TitleFontSize},
                        Tablet={StaticResource LargeTitleFontSize}
                    }"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    TextColor="{ DynamicResource TextColor }"
                />

                <!-- PRICE -->
                <Label
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Text="{ Binding Product.Price }"
                    FontAttributes="Bold"
                    FontSize="{ OnIdiom
                        Phone={StaticResource TitleFontSize},
                        Tablet={StaticResource LargeTitleFontSize}
                    }"
                    HorizontalOptions="End"
                    TextColor="{ DynamicResource SuccessColor }"
                    VerticalTextAlignment="End"
                />

                <!-- DESCRIPTION -->
                <ScrollView
                    Grid.Row="2"
                    Padding="0,10,0,0">
                    <VerticalStackLayout Spacing="15">
                        <Label
                            Text="{ Binding Product.Description }"
                            HorizontalOptions="Fill"
                            HeightRequest="80"
                            TextColor="{ DynamicResource TextSecondaryColor }"
                            FontSize="{ OnIdiom
                                Phone={StaticResource BaseFontSize},
                                Tablet={StaticResource SmallTitleFontSize}
                            }"
                        />
                    </VerticalStackLayout>
                </ScrollView>
            </grial:ExtendedGrid>

            <Grid
                Grid.Row="2"
                ColumnSpacing="15"
                Padding="{ DynamicResource AirSpacingNoTop }"
                ColumnDefinitions="Auto,*">

                <Grid WidthRequest="{ grial:OnOrientationDouble Portrait=-1, Landscape=100 }">
                    <BoxView
                        CornerRadius="{ DynamicResource BaseCornerRadius }"
                        Opacity="0.08"
                        Color="{ DynamicResource FavoriteColor }"
                    />

                    <!-- FAVORITE ICON -->
                    <grial:Checkbox
                        Margin="20,0"
                        HorizontalOptions="Center"
                        IconFontSize="{ OnIdiom
                            Phone=28,
                            Tablet=38
                        }"
                        ControlTemplate="{ StaticResource CheckboxHeartTemplate }"
                        IsChecked="{ Binding IsFavorite, Mode=TwoWay }"
                        VerticalOptions="Center"
                        grial:Animate.Tapped="{ StaticResource Animation_Pulse }" />
                </Grid>

                <!-- -BUY BUTTON -->
                <Button
                    Grid.Column="1"
                    Style="{ StaticResource PrimaryActionButtonStyle }"
                    Text="{ grial:Translate Key=ButtonAddToCart }"
                    WidthRequest="{ grial:OnOrientationSizeRequest
                        LandscapePhone=200,
                        LandscapeTablet=400
                    }"
                    HorizontalOptions="{ grial:OnOrientationLayoutOptions
                        PortraitPhone=Fill,
                        LandscapePhone=End,
                        PortraitTablet=Fill,
                        LandscapeTablet=End
                    }"
                />
            </Grid>

        </Grid>
    </ContentView.Content>
</ContentView>
