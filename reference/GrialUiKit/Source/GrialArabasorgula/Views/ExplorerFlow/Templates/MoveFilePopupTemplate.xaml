<?xml version="1.0" encoding="utf-8" ?>
<uxd:PopupPage
    x:Class="arabasorgula.MoveFilePopupTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:uxd="clr-namespace:UXDivers.Popups.Maui;assembly=UXDivers.Popups.Maui"
    x:Name="root"
    grial:Effects.ApplyIOSSafeAreaAsPadding="Top"
    BackgroundColor="{ DynamicResource OverlayColor }"
    AppearingAnimation="{ uxd:MoveInPopupAnimation
        MoveDirection=Bottom,
        Duration=300,
        Easing=CubicOut
    }"
    DisappearingAnimation="{ uxd:MoveOutPopupAnimation
        MoveDirection=Bottom,
        Duration=300,
        Easing=CubicOut
    }">

    <uxd:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:DialogsResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </uxd:PopupPage.Resources>

    <Grid
        HeightRequest="-1"
        VerticalOptions="Fill"
        RowDefinitions="54,Auto,*,Auto"
        grial:Effects.CornerRadius="{ DynamicResource BaseTopCornerRadius }"
        Padding="{ DynamicResource AirSpacing }"
        BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
        RowSpacing="20">
        <!-- TITLE -->
        <Grid
            Grid.Row="0"
            Padding="0">
            <!-- BACK BUTTON -->
            <Label
                IsVisible="{ Binding IsBackButtonVisible }"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Text="{ x:Static local:GrialIconsFont.ChevronLeft }"
                FontSize="30"
                TextColor="{ DynamicResource TextSecondaryColor }"
                Style="{ StaticResource FontIcon }">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{ Binding BackNavigationCommand }" />
                </Label.GestureRecognizers>
            </Label>

            <!-- TITLE -->
            <Label
                Text="Move File"
                VerticalTextAlignment="Center"
                FontSize="24"
                HorizontalOptions="Center"
            />

            <!-- CLOSE BUTTON -->
            <Label
                VerticalOptions="Center"
                HorizontalOptions="End"
                FontSize="30"
                Text="{ x:Static local:GrialIconsFont.Close }"
                Style="{ StaticResource FontIcon }"
                TextColor="{ DynamicResource TextSecondaryColor }">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{ Binding CloseCommand }" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- SEARCH -->
        <Entry
            Grid.Row="1"
            PlaceholderColor="#8B95AE"
            BackgroundColor="{ DynamicResource SecondaryCardBackgroundColor }"
            Placeholder="{ grial:Translate StringSearch }"
        />

        <!-- EMPTY MESSAGE -->
        <Grid
            IsVisible="{ grial:Eval
                'A == 0',
                A={Binding Items.Count}
            }"
            Grid.Row="2"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            RowDefinitions="Auto,Auto"
            RowSpacing="10">
            <!-- ICON -->
            <local:RoundedIcon
                HorizontalOptions="Center"
                IconFontSize="18"
                IconText="{ x:Static local:GrialIconsFont.File }"
                IconColor="{ DynamicResource TextSecondaryColor }"
                IconBackgroundColor="{ DynamicResource TextSecondaryColor }"
                IconBackgroundOpacity="0.1"
                IconBackgroundCornerRadius="{ DynamicResource CornerRadius-md }"
                HeightRequest="44"
                WidthRequest="44"
            />

            <!-- MESSAGE -->
            <Label
                Grid.Row="1"
                TextColor="{ DynamicResource TextSecondaryColor }"
                Text="You don't have   any files yet!"
            />
        </Grid>

        <!-- FILE AND FOLDERS LIST -->
        <CollectionView
            IsVisible="{ grial:Eval
                'A &gt; 0',
                A={Binding Items.Count}
            }"
            Grid.Row="2"
            SelectionMode="None"
            ItemsSource="{ Binding Items }"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Margin="0,0,0,20"
                        RowDefinitions="25,25"
                        ColumnDefinitions="40,*,Auto"
                        ColumnSpacing="15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{ Binding BindingContext.ItemSelectedCommand, Source={x:Reference root} }"
                                CommandParameter="{ Binding . }"
                            />
                        </Grid.GestureRecognizers>

                        <!-- FOLDER ICON -->
                        <local:RoundedIcon
                            Grid.RowSpan="2"
                            VerticalOptions="Center"
                            IconText="{ x:Static local:GrialIconsFont.Folder }"
                            HeightRequest="40"
                            WidthRequest="40"
                            IconFontSize="18"
                            IconColor="{ Binding BackgroundColor }"
                            IconBackgroundColor="{ Binding BackgroundColor }"
                            IconBackgroundOpacity=".1"
                            IconBackgroundCornerRadius="{ DynamicResource CornerRadius-md }"
                        />

                        <!-- FOLDER NAME -->
                        <Label
                            Margin="0,10,0,0"
                            Grid.Column="1"
                            VerticalOptions="End"
                            Text="{ Binding Name }"
                        />

                        <!-- FOLDER CREATED DATE -->
                        <Label
                            VerticalOptions="Start"
                            Grid.Column="1"
                            Grid.Row="1"
                            FontSize="{ StaticResource SmallFontSize }"
                            TextColor="{ DynamicResource TextSecondaryColor }"
                            Text="{ Binding CreationDate }"
                        />

                        <!-- SEPARATOR -->
                        <BoxView
                            Margin="-15,0,0,-10"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            VerticalOptions="End"
                            Style="{ StaticResource Horizontal1ptLineStyle }"
                        />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- MOVE BUTTON -->
        <Button
            Grid.Row="3"
            Text="Move"
            Style="{ StaticResource PrimaryActionButtonStyle }"
            Command="{ Binding MoveCommand }"
        />
    </Grid>
</uxd:PopupPage>