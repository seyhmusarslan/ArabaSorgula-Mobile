<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ArticlesListVariantPage"
    Title="{ grial:Translate PageTitleArticlesListVariant }"
    BackgroundColor="{ DynamicResource BackgroundColor }">
    <CollectionView ItemsSource="{ Binding List }">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <local:ArticleVariantItemTemplate
                    HeightRequest="310"
                    Padding="{ StaticResource MainWrapperPadding }">
                    <View.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnItemTapped" />
                    </View.GestureRecognizers>
                </local:ArticleVariantItemTemplate>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>