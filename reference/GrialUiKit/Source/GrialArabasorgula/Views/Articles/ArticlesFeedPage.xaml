<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ArticlesFeedPage"
    Title="{ grial:Translate PageTitleArticlesFeed }"
    BackgroundColor="{ DynamicResource BackgroundColor }">
    <CollectionView
        ItemsSource="{ Binding List }"
        Style="{ StaticResource ResponsiveLandscapeMarginStyle }">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <local:ArticleFeedItemTemplate Padding="{ StaticResource MainWrapperPadding }">
                    <View.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnItemTapped" />
                    </View.GestureRecognizers>
                </local:ArticleFeedItemTemplate>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>