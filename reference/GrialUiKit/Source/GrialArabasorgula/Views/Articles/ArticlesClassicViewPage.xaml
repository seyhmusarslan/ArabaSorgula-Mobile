<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ArticlesClassicViewPage"
    Title="{ grial:Translate PageTitleArticlesClassicView }"
    BackgroundColor="{ DynamicResource BackgroundColor }">
    <CollectionView
        Margin="0,10,0,0"
        ItemsSource="{ Binding List }"
        VerticalScrollBarVisibility="Never">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <local:ArticleClassicViewItemTemplate
                    HeightRequest="140"
                    Padding="{ StaticResource MainWrapperPadding }">
                    <View.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnItemTapped" />
                    </View.GestureRecognizers>
                </local:ArticleClassicViewItemTemplate>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>