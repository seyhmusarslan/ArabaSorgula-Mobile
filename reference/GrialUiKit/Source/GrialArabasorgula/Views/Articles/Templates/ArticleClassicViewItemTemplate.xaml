<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ArticleClassicViewItemTemplate">
    <Grid
        RowSpacing="5"
        ColumnSpacing="20"
        Padding="{ DynamicResource AirSpacingWithBorder }"
        ColumnDefinitions="100, *"
        RowDefinitions="20,*,16">

        <!-- Article Image -->
        <Image
            Margin="0,-5"
            Grid.Row="0"
            Grid.RowSpan="3"
            HeightRequest="100"
            WidthRequest="100"
            Source="{ Binding BackgroundImage }"
            grial:Effects.DropShadow="Light"
            grial:Effects.CornerRadius="{ DynamicResource BaseCornerRadius }"
        />

        <!-- Article Title -->
        <Label
            Grid.Row="0"
            Grid.Column="1"
            Text="{ Binding Title }"
            FontAttributes="Bold"
            FontSize="{ StaticResource LargeFontSize }"
            LineBreakMode="TailTruncation"
            TextColor="{ OnPlatform Default={StaticResource TextColor} }"
        />

        <!-- Article Date -->
        <Label
            Grid.Row="2"
            Grid.Column="1"
            Text="{ Binding When }"
            Opacity="1"
            FontSize="{ StaticResource SmallFontSize }"
            TextColor="{ DynamicResource PrimaryColor }"
        />

        <!-- Article Description -->
        <Label
            Grid.Row="1"
            Grid.Column="1"
            Text="{ Binding Body }"
            TextColor="{ DynamicResource TextSecondaryColor }"
            FontSize="{ grial:OnOrientationDouble
                PortraitPhone={StaticResource SmallFontSize},
                LandscapePhone={StaticResource SmallFontSize},
                PortraitTablet={StaticResource BaseFontSize},
                LandscapeTablet={StaticResource BaseFontSize}
            }"
        />

        <!-- SEPARATOR -->
        <BoxView
            Grid.Row="2"
            Style="{ StaticResource Horizontal1ptLineStyle }"
            Grid.Column="1"
            Grid.ColumnSpan="1"
            VerticalOptions="End"
            Margin="0,0,-30,-20"
        />
    </Grid>
</ContentView>
