<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.ArticleColumnsHeaderItemTemplate">

    <!-- MAIN CONTAINER -->
    <Grid
        Grid.Row="0"
        Margin="{ DynamicResource AirSpacing }"
        grial:Effects.CornerRadius="{ DynamicResource BaseCornerRadius }"
        Padding="20"
        RowSpacing="5"
        ColumnSpacing="0"
        BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
        ColumnDefinitions="*"
        RowDefinitions="160,Auto,*,Auto">

        <!-- IMAGE -->
        <Image
            Margin="-20,-20,-20,6"
            grial:Effects.CornerRadius="{ DynamicResource CornerRadius-big }"
            Grid.RowSpan="1"
            Source="{ Binding BackgroundImage }"
        />

        <!-- TITLE -->
        <Label
            Grid.Row="1"
            Grid.Column="0"
            Margin="0"
            Text="{ Binding Title }"
            FontAttributes="Bold"
            FontSize="{ grial:OnOrientationDouble
                PortraitPhone=14,
                LandscapePhone=14,
                PortraitTablet=18,
                LandscapeTablet=22
            }"
            LineBreakMode="TailTruncation"
            TextColor="{ DynamicResource TextColor }"
        />

        <!-- ARTICLE NEWS -->
        <Label
            Grid.Row="2"
            Grid.Column="0"
            VerticalOptions="Start"
            Margin="0"
            Text="{ Binding Body }"
            FontSize="{ grial:OnOrientationDouble
                PortraitPhone={StaticResource SmallFontSize},
                LandscapePhone={StaticResource SmallFontSize},
                PortraitTablet=14,
                LandscapeTablet=14
            }"
            LineBreakMode="WordWrap"
            MaxLines="3"
            TextColor="{ DynamicResource TextSecondaryColor }"
        />

        <!-- FOOTER -->
        <HorizontalStackLayout
            Grid.Row="3"
            Grid.Column="0"
            Margin="0"
            VerticalOptions="End">

            <Label
                TextColor="{ DynamicResource PrimaryColor }"
                Text="{ Binding When }"
                Opacity="1"
                FontSize="{ grial:OnOrientationDouble
                    PortraitPhone={StaticResource SmallFontSize},
                    LandscapePhone={StaticResource SmallFontSize},
                    PortraitTablet=14,
                    LandscapeTablet=14
                }"
                HorizontalOptions="Fill"
            />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
