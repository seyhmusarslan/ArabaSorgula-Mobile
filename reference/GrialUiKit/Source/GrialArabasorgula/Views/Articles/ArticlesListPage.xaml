<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ArticlesListPage"
    Title="{ grial:Translate PageTitleArticlesList }"
    BackgroundColor="{ DynamicResource BackgroundColor }">
    <CollectionView ItemsSource="{ Binding List }">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <local:ArticleItemTemplate HeightRequest="280">
                    <View.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnItemTapped" />
                    </View.GestureRecognizers>
                </local:ArticleItemTemplate>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
