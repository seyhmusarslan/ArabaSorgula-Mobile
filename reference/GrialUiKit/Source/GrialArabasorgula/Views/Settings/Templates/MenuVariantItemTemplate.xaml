<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.MenuVariantItemTemplate">
    <!-- CONTAINER -->
    <Grid
        RowDefinitions="Auto,Auto"
        ColumnDefinitions="Auto,*,Auto"
        ColumnSpacing="16"
        Padding="{ DynamicResource AirSpacingSmallBorder }"
        Style="{ DynamicResource OnIdiomResponsiveMarginStyle }">
        <!-- HEADER -->
        <Label
            Text="{ Binding Header, Converter={StaticResource ToUpperConverter} }"
            FontSize="{ StaticResource LargeFontSize }"
            TextColor="{ DynamicResource TextSecondaryColor }"
            VerticalOptions="End"
            Grid.ColumnSpan="3"
            IsVisible="{ Binding IsHeader }"
            Margin="0,20,0,10"
        />
        <!-- ICON -->
        <local:RoundedIcon
            Grid.Row="1"
            HeightRequest="44"
            WidthRequest="44"
            IconText="{ Binding Icon }"
            IconFontSize="{ StaticResource TitleFontSize }"
            IconColor="{ Binding IconColorColor }"
            IconBackgroundColor="{ Binding IconColorColor }"
            IconBackgroundOpacity="0.1"
            VerticalOptions="Center"
            IconBackgroundCornerRadius="{ DynamicResource CornerRadius-md }"
        />
        <!-- CATEGORY -->
        <Label
            Grid.Column="1"
            Grid.Row="1"
            Text="{ Binding Category }"
            VerticalTextAlignment="Center"
        />
        <!-- ARROW -->
        <Label
            Grid.Column="2"
            Grid.Row="1"
            Text="{ x:Static local:GrialIconsFont.ChevronRight }"
            FontFamily="{ DynamicResource IconsFontFamily }"
            FontSize="{ StaticResource TitleFontSize }"
            VerticalTextAlignment="Center"
        />
        <!-- LINE SEPARATOR -->
        <BoxView
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            VerticalOptions="End"
            Style="{ StaticResource Horizontal1ptLineStyle }"
            Margin="0,0,0,-10"
        />
    </Grid>
</ContentView>