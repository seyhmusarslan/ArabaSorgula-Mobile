<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.CategoriesItemTemplate">
    <!-- CONTAINER -->
    <Grid
        RowDefinitions="Auto,54"
        ColumnDefinitions="Auto,*,Auto"
        ColumnSpacing="16"
        Margin="{ DynamicResource AirSpacingNoBorder }">
        <!-- SECTION SEPARATOR -->
        <BoxView
            HeightRequest="24"
            Color="Transparent"
            IsVisible="{ Binding IsSpacing }"
            Grid.ColumnSpan="3"
        />
        <!-- ICON -->
        <Label
            Grid.Row="1"
            Text="{ Binding Icon }"
            FontFamily="{ DynamicResource IconsFontFamily }"
            FontSize="{ StaticResource TitleFontSize }"
            TextColor="{ grial:If
                Condition={Binding IsSignOut},
                Then={DynamicResource ErrorColor},
                Else={DynamicResource PrimaryColor}
            }"
            VerticalTextAlignment="Center"
        />
        <!-- CATEGORY -->
        <Label
            Grid.Row="1"
            Grid.Column="1"
            Text="{ Binding Category }"
            TextColor="{ grial:If
                Condition={Binding IsSignOut},
                Then={DynamicResource ErrorColor},
                Else={DynamicResource TextColor}
            }"
            VerticalTextAlignment="Center"
        />
        <!-- ARROW -->
        <Label
            Grid.Row="1"
            Grid.Column="2"
            Text="{ x:Static local:GrialIconsFont.ChevronRight }"
            FontFamily="{ DynamicResource IconsFontFamily }"
            FontSize="{ StaticResource TitleFontSize }"
            VerticalTextAlignment="Center"
            IsVisible="{ Binding IsLink }"
        />
        <!-- SWITCH -->
        <Switch
            Grid.Row="1"
            Grid.Column="2"
            VerticalOptions="Center"
            IsVisible="{ Binding IsToggle }"
        />
        <!-- LINE SEPARATOR -->
        <BoxView
            Grid.Row="1"
            Grid.ColumnSpan="3"
            VerticalOptions="End"
            Style="{ StaticResource Horizontal1ptLineStyle }"
            Margin="{ DynamicResource RemoveParentAirSpacing }"
        />

    </Grid>
</ContentView>

