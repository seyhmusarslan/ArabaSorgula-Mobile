<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.ProfileItemTemplate">
    <!-- CONTAINER -->
    <Grid
        Padding="{ DynamicResource AirSpacingNoBorder }"
        Style="{ DynamicResource OnIdiomResponsiveMarginStyle }"
        RowDefinitions="Auto,Auto">
        <!-- HEADER -->
        <Label
            Text="{ Binding Header }"
            FontSize="{ StaticResource LargeFontSize }"
            VerticalOptions="End"
            Grid.ColumnSpan="2"
            IsVisible="{ Binding IsHeader }"
            Margin="0,12,0,12"
        />
        <!-- CARD CONTAINER -->
        <grial:CardView
            Grid.Row="1"
            HasShadow="False"
            Padding="20,16"
            ColumnSpacing="16"
            ColumnDefinitions="*,Auto"
            RowDefinitions="*,Auto">
            <!-- CATEGORY -->
            <Label
                Text="{ Binding Category }"
                VerticalTextAlignment="Center"
            />
            <!-- DESCRIPTION -->
            <Label
                Grid.Row="1"
                Text="{ Binding Description }"
                VerticalOptions="Center"
                FontSize="{ StaticResource SmallFontSize }"
                TextColor="{ DynamicResource TextSecondaryColor }"
                IsVisible="{ Binding HasDescription }"
                VerticalTextAlignment="Center"
            />
            <!-- ARROW -->
            <Label
                Grid.Column="2"
                Grid.RowSpan="2"
                Text="{ x:Static local:GrialIconsFont.ChevronRight }"
                FontFamily="{ DynamicResource IconsFontFamily }"
                FontSize="{ StaticResource TitleFontSize }"
                VerticalTextAlignment="Center"
                IsVisible="{ Binding IsLink }"
            />
            <!-- SWITCH -->
            <Switch
                Grid.Column="2"
                Grid.RowSpan="2"
                VerticalOptions="Center"
                IsVisible="{ Binding IsToggle }"
                IsToggled="{ Binding IsToggled }"
            />
        </grial:CardView>
    </Grid>
</ContentView>