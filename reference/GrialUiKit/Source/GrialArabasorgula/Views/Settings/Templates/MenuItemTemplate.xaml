<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="arabasorgula.MenuItemTemplate"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula">
    <!-- CONTAINER -->
    <Grid
        RowDefinitions="Auto,Auto"
        ColumnDefinitions="Auto,*,Auto"
        ColumnSpacing="16"
        Padding="0,16">
        <!-- EMOJI -->
        <local:Emoji
            Grid.RowSpan="2"
            HeightRequest="24"
            WidthRequest="24"
            Unicode="{ Binding Icon }"
            HorizontalOptions="Center"
        />
        <!-- CATEGORY -->
        <Label
            Grid.Column="1"
            Text="{ Binding Category }"
            VerticalTextAlignment="End"
        />
        <!-- DESCRIPTION -->
        <Label
            Grid.Row="1"
            Grid.Column="1"
            Text="{ Binding Description }"
            FontSize="{ StaticResource SmallFontSize }"
            VerticalTextAlignment="Start"
            TextColor="{ DynamicResource TextSecondaryColor }"
        />
        <!-- ARROW -->
        <Label
            Grid.RowSpan="2"
            Grid.Column="2"
            Text="{ x:Static local:GrialIconsFont.ChevronRight }"
            FontFamily="{ DynamicResource IconsFontFamily }"
            FontSize="{ StaticResource TitleFontSize }"
            VerticalTextAlignment="Center"
        />
        <!-- LINE SEPARATOR -->
        <BoxView
            Grid.Row="1"
            Grid.ColumnSpan="3"
            VerticalOptions="End"
            Style="{ StaticResource Horizontal1ptLineStyle }"
            Margin="0,0,0,-16"
        />

    </Grid>

</ContentView>


