<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.MainCategoriesItemTemplate">

    <!-- CARD CONTAINER -->
    <grial:CardView
        RowDefinitions="*,Auto"
        HasShadow="False"
        Padding="20">
        <!-- ICON -->
        <Label
            Text="{ Binding Icon }"
            FontFamily="{ DynamicResource IconsFontFamily }"
            FontSize="32"
            TextColor="{ DynamicResource PrimaryColor }"
        />
        <!-- CATEGORY -->
        <Label
            Grid.Row="1"
            Text="{ Binding Category }"
        />
    </grial:CardView>

</ContentView>