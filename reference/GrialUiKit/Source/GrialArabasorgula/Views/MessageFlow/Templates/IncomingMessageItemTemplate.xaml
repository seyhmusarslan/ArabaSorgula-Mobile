<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.IncomingMessageItemTemplate">
    <Grid
        ColumnSpacing="0"
        RowSpacing="6"
        Margin="20,10,90,10"
        RowDefinitions="*">
        <!-- BALLOON BACKGROUND -->
        <grial:CardView
            HasShadow="False"
            BackgroundColor="{ DynamicResource ChatLeftBalloonBackgroundColor }"
            Padding="15"
            RowDefinitions="Auto,Auto">

            <!-- TEXT -->
            <Label
                Margin="0,0,0,5"
                FontSize="{ StaticResource BaseFontSize }"
                Text="{ Binding Text }"
                TextColor="{ DynamicResource OnSurfaceColor }"
                VerticalOptions="End"
            />

            <!-- WHEN -->
            <Label
                Grid.Row="1"
                FontSize="11"
                TextColor="{ DynamicResource TextOnSurfaceColor }"
                HorizontalOptions="End"
                Text="{ Binding When }"
            />
        </grial:CardView>
    </Grid>
</ContentView>
