<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="arabasorgula.CustomPickerTemplate"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula">
    <Grid
        ColumnDefinitions="Auto,*"
        Padding="20,0"
        BackgroundColor="{ DynamicResource EntryAndEditorsBackgroundColor }"
        grial:Effects.CornerRadius="{ DynamicResource BaseCornerRadius }"
        HeightRequest="54">
        <!-- LABEL -->
        <Label
            Text="{ Binding PickerTitle }"
            FontSize="14"
            VerticalOptions="Center"
            HorizontalOptions="Start"
            TextColor="{ DynamicResource TextSecondaryColor }"
            InputTransparent="true"
        />

        <!-- OPTIONS -->
        <Picker
            Grid.Column="1"
            Style="{ StaticResource SingleLinePickerStyle }"
            BackgroundColor="Transparent"
            Title="Select"
            TextColor="{ DynamicResource PrimaryColor }"
            FontFamily="{ StaticResource AppSemiBoldFamily }"
            HorizontalTextAlignment="End"
            VerticalOptions="Center"
            ItemsSource="{ Binding PickerOptions }"
        />
    </Grid>

</ContentView>

