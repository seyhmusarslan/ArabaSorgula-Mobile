<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    grial:GrialNavigationPage.HasNavigationBar="False"
    x:Class="arabasorgula.PasswordRecoveryPage"
    Title="{ grial:Translate PageTitlePasswordRecovery }"
    BackgroundColor="{ DynamicResource BackgroundSecondaryColor }">

    <Grid>
        <ScrollView>
            <!-- MAIN CONTAINER -->
            <Grid
                Style="{ StaticResource BaseFormsContentStyle }"
                ColumnSpacing="0"
                RowSpacing="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                RowDefinitions="120,Auto,*,100">

                <!-- Logo -->
                <local:BrandLogo
                    VerticalOptions="End"
                    HorizontalOptions="Start"
                    Grid.Row="0"
                    Inverted="False"
                />

                <!-- CLAIM TEXT -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Spacing="10"
                    Padding="0,10"
                    VerticalOptions="Center">
                    <Label
                        LineBreakMode="WordWrap"
                        Text="{ grial:Translate LabelForgotYourPassword }"
                        TextColor="{ DynamicResource TextColor }"
                        VerticalTextAlignment="Center"
                        FontAttributes="Bold"
                        FontSize="{ OnIdiom
                            Phone=24,
                            Tablet=34
                        }"
                    />

                    <Label
                        LineBreakMode="WordWrap"
                        Text="{ grial:Translate LabelForgotYourPasswordExplained }"
                        TextColor="{ DynamicResource PrimaryColor }"
                        VerticalTextAlignment="Center"
                        FontSize="{ OnIdiom
                            Phone=16,
                            Tablet=26
                        }"
                    />

                    <!-- EMAIL ENTRY -->
                    <Entry
                        Placeholder="{ grial:Translate StringEmail }"
                        Margin="0,20,0,0">
                        <Entry.Behaviors>
                            <grial:EmailValidatorBehavior x:Name="emailValidation" />
                        </Entry.Behaviors>
                    </Entry>

                    <grial:RoundedLabel
                        Text="{ grial:Translate Key=ErrorPleaseEnterValidEmail }"
                        IsVisible="{ Binding IsValid, Source={x:Reference emailValidation}, Converter={StaticResource NegateBooleanConverter} }"
                        Style="{ StaticResource ValidationEntryErrorStyle }"
                    />

                    <Button
                        Margin="0,20,0,0"
                        Text="{ grial:Translate Key=StringSend }"
                        Style="{ StaticResource PrimaryActionButtonStyle }"
                        WidthRequest="{ grial:OnOrientationSizeRequest
                            LandscapePhone=200,
                            LandscapeTablet=400
                        }"
                        HorizontalOptions="{ grial:OnOrientationLayoutOptions
                            Portrait=Fill,
                            Landscape=Center
                        }"
                    />

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- CLOSE ICON -->
        <local:RoundedIconButton
            HorizontalOptions="End"
            Style="{ StaticResource CloseIconButtonInverseStyle }"
            Clicked="OnCloseButtonClicked"
        />
    </Grid>
</ContentPage>
