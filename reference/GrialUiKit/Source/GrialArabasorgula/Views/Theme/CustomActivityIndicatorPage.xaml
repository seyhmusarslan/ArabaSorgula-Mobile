<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.CustomActivityIndicatorPage"
    BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
    Title="{ grial:Translate PageTitleCustomActivityIndicator }">

    <Grid
        VerticalOptions="Center"
        RowSpacing="10"
        RowDefinitions="Auto,*">

        <local:CustomActivityIndicator
            Grid.Row="0"
            x:Name="Indicator"
            HorizontalOptions="Center"
            VerticalOptions="Center"
        />

        <Label
            Grid.Row="1"
            HorizontalTextAlignment="Center"
            Text="{ grial:Translate StringLoading }"
        />
    </Grid>
</ContentPage>
