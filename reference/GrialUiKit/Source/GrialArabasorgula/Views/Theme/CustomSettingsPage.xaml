<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.CustomSettingsPage"
    Title="{ grial:Translate PageTitleCustomSettings }"
    BackgroundColor="{ DynamicResource BackgroundColor }">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryTextColor">#333333</Color>
            <Color x:Key="PseudoTableSectionTitleBackgroundColor">#05000000</Color>
            <Color x:Key="PseudoTableSectionLineBackgroundColor">#22000000</Color>

            <x:Double x:Key="PseudoTableSectionTitleFontSize">12</x:Double>
            <x:Double x:Key="PseudoTableSectionTitleHeight">60</x:Double>
            <x:Double x:Key="PseudoTableSectionTitleLineHeight">1</x:Double>
            <x:Double x:Key="PseudoTableSectionTextHeight">44</x:Double>
            <x:Double x:Key="PseudoTableSectionLineHeight">1</x:Double>

            <Style x:Key="PseudoTableSectionTitleStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{ DynamicResource PrimaryColor }" />
                <Setter Property="VerticalTextAlignment" Value="End" />
                <Setter Property="FontSize" Value="{ StaticResource PseudoTableSectionTitleFontSize }" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="TranslationY" Value="-10" />
                <Setter Property="HeightRequest" Value="{ StaticResource PseudoTableSectionTitleHeight }" />
            </Style>

            <Style x:Key="PseudoTableSectionTitleIconStyle" TargetType="Label" BasedOn="{ StaticResource FontIcon }">
                <Setter Property="TextColor" Value="{ DynamicResource PrimaryColor }" />
                <Setter Property="VerticalTextAlignment" Value="End" />
                <Setter Property="FontSize" Value="{ StaticResource BaseFontSize }" />
            </Style>

            <Style x:Key="PseudoTableSectionLineBaseStyle" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="{ StaticResource PseudoTableSectionLineHeight }" />
                <Setter Property="Margin" Value="30,20,30,0" />
            </Style>

            <Style x:Key="PseudoTableSectionLineStyle" BasedOn="{ StaticResource PseudoTableSectionLineBaseStyle }" TargetType="BoxView">
                <Setter Property="BackgroundColor" Value="{ StaticResource ListSeparatorColor }" />
            </Style>

            <Style x:Key="PseudoTableSectionTitleLineStyle" BasedOn="{ StaticResource PseudoTableSectionLineBaseStyle }" TargetType="BoxView">
                <Setter Property="Color" Value="{ DynamicResource PrimaryColor }" />
                <Setter Property="HeightRequest" Value="{ StaticResource PseudoTableSectionTitleLineHeight }" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="Margin" Value="-10,0" />
            </Style>

            <Style x:Key="PseudoTableSectionTitleBackgroundStyle" TargetType="Grid">
                <Setter Property="Padding" Value="30,20,35,0" />
            </Style>

            <Style x:Key="PseudoTableSectionTextStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="VerticalOptions" Value="Fill" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="TextColor" Value="{ DynamicResource TextSecondaryColor }" />
                <Setter Property="HeightRequest" Value="{ StaticResource PseudoTableSectionTextHeight }" />
            </Style>

            <Style x:Key="PseudoTableSectionSwitchStyle" TargetType="Switch">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="PseudoTableSectionGroupStyle" TargetType="Grid">
                <Setter Property="Padding" Value="{ DynamicResource AirSpacingNoBorder }" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <ScrollView>

            <VerticalStackLayout
                x:Name="stack"
                Spacing="10"
                Padding="0,0,0,20">

                <!-- GENERAL -->
                <Grid
                    Style="{ StaticResource PseudoTableSectionTitleBackgroundStyle }"
                    ColumnDefinitions="Auto,*">

                    <!-- TITLE -->
                    <local:EmojiText
                        Icon="{ x:Static local:Emojis.wrench }"
                        IconSize="22"
                        Text="{ grial:Translate StringGeneral }"
                        Orientation="InvertedHorizontal"
                        TextFontSize="22"
                        TextColor="{ DynamicResource TextColor }"
                        Spacing="8"
                    />
                </Grid>


                <!-- GENERAL - FIRST ROW -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    Style="{ StaticResource PseudoTableSectionGroupStyle }">

                    <!-- Description -->
                    <Label
                        VerticalOptions="Center"
                        Text="{ grial:Translate Key=LabelDisplayGlobalIssues }"
                        Style="{ StaticResource PseudoTableSectionTextStyle }"
                    />

                    <!-- Action -->
                    <Switch
                        Grid.Column="1"
                        Style="{ StaticResource PseudoTableSectionSwitchStyle }"
                    />
                </Grid>

                <!-- GENERAL - SECOND ROW -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    Style="{ StaticResource PseudoTableSectionGroupStyle }">

                    <!-- Description -->
                    <Label
                        VerticalOptions="Center"
                        Text="{ grial:Translate Key=LabelClearImageCache }"
                        Style="{ StaticResource PseudoTableSectionTextStyle }"
                    />

                    <!-- Action -->
                    <Switch
                        Grid.Column="1"
                        Style="{ StaticResource PseudoTableSectionSwitchStyle }"
                    />
                </Grid>

                <!-- SEPARATOR -->
                <BoxView Style="{ StaticResource PseudoTableSectionLineStyle }" />

                <!-- SOCIAL NETWORKS -->
                <Grid
                    Style="{ StaticResource PseudoTableSectionTitleBackgroundStyle }"
                    ColumnDefinitions="Auto,*">

                    <!-- TITLE -->
                    <local:EmojiText
                        Icon="{ x:Static local:Emojis.man_technologist }"
                        IconSize="24"
                        Text="{ grial:Translate StringSocialNetworks }"
                        Orientation="InvertedHorizontal"
                        TextFontSize="22"
                        TextColor="{ DynamicResource TextColor }"
                        Spacing="8"
                    />

                </Grid>


                <!-- SOCIAL NETWORKS - First Row -->
                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    Style="{ StaticResource PseudoTableSectionGroupStyle }">

                    <!-- Icon -->
                    <Label
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center"
                        Text="{ x:Static local:GrialIconsFont.LogoTwitter }"
                        TextColor="#00ACED"
                        Margin="0,0,8,0"
                        Style="{ StaticResource PseudoTableSectionTitleIconStyle }"
                    />

                    <!-- Description -->
                    <Label
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Text="{ grial:Translate Key=StringTwitter }"
                        Style="{ StaticResource PseudoTableSectionTextStyle }"
                    />

                    <!-- Action -->
                    <Switch
                        Grid.Column="2"
                        Style="{ StaticResource PseudoTableSectionSwitchStyle }"
                        IsToggled="true"
                    />
                </Grid>

                <!-- SOCIAL NETWORKS - Second Row -->
                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    Style="{ StaticResource PseudoTableSectionGroupStyle }">
                    <!-- Icon -->
                    <Label
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center"
                        Text="{ x:Static local:GrialIconsFont.LogoFacebook }"
                        TextColor="#49659F"
                        Margin="0,0,8,0"
                        Style="{ StaticResource PseudoTableSectionTitleIconStyle }"
                    />

                    <!-- Description -->
                    <Label
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Text="{ grial:Translate Key=StringFacebook }"
                        Style="{ StaticResource PseudoTableSectionTextStyle }"
                    />

                    <!-- Action -->
                    <Switch
                        Grid.Column="2"
                        Style="{ StaticResource PseudoTableSectionSwitchStyle }"
                    />
                </Grid>

                <!-- SOCIAL NETWORKS - Third Row -->
                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    Style="{ StaticResource PseudoTableSectionGroupStyle }">
                    <!-- Icon -->
                    <Label
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center"
                        Text="{ x:Static local:GrialIconsFont.LogoLinkedin }"
                        TextColor="#49659F"
                        Margin="0,0,8,0"
                        Style="{ StaticResource PseudoTableSectionTitleIconStyle }"
                    />

                    <!-- Description -->
                    <Label
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Text="{ grial:Translate Key=StringLinkedin }"
                        Style="{ StaticResource PseudoTableSectionTextStyle }"
                    />

                    <!-- Action -->
                    <Switch
                        Grid.Column="2"
                        Style="{ StaticResource PseudoTableSectionSwitchStyle }"
                    />
                </Grid>

                <!-- SEPARATOR -->
                <BoxView Style="{ StaticResource PseudoTableSectionLineStyle }" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>
