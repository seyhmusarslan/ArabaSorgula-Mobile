<?xml version="1.0" encoding="utf-8" ?>
<NavigationPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.MoviesNavigationPage"
    grial:GrialNavigationPage.BarType="Transparent"
    grial:GrialNavigationPage.BarBackgroundColor="Transparent"
    BarTextColor="{ DynamicResource TextColor }">

    <NavigationPage.ToolbarItems>
        <grial:ExtendedToolbarItem
            FontFamily="{ StaticResource IconsFontFamily }"
            Glyph="{ x:Static local:GrialIconsFont.Close }"
            Size="24"
            Clicked="OnClose"
            Color="{ DynamicResource TextColor }"
        />
    </NavigationPage.ToolbarItems>
</NavigationPage>
