<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.MoviesMainPage"
    BackgroundColor="{ DynamicResource BackgroundColor }"
    grial:GrialNavigationPage.BarTextColor="{ DynamicResource TextColor }"
    grial:GrialNavigationPage.BarBackgroundColor="Transparent">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- <x:Double
                x:Key="SmallHeaderHorizontalAnimationThreshold">270</x:Double>-->
            <!-- <x:Double
                x:Key="CarouselHeightStopsChangingWhenScrollIs">240</x:Double>-->
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="430,*">
        <!-- Height used as reference to save the space of the navigation bar inside the carousel items -->
        <ScrollView
            x:Name="scrollView"
            VerticalScrollBarVisibility="Never"
            Grid.RowSpan="2"
            grial:Effects.IgnoreIOSSafeAreaOnScrollView="Top,Left,Right">
            <VisualElement.Behaviors>
                <grial:ScrollViewScrollBehavior x:Name="scroll" />
            </VisualElement.Behaviors>

            <Grid grial:Effects.ApplyIOSSafeAreaAsPadding="Left,Right">
                <!-- Handles tap when page is on the initial state -->
                <BoxView
                    HeightRequest="480"
                    Color="Transparent"
                    VerticalOptions="Start">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFeatured" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <VerticalStackLayout
                    Margin="0,480,0,10"
                    BindableLayout.ItemsSource="{ Binding Sections }"
                    Spacing="20">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <local:MoviesSectionTemplate
                                TitleMargin="35,20,35,0"
                                ScrollPadding="{ DynamicResource AirSpacingNoBorder }"
                            />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Carousel container goes outside the scrollview as its position is fixed -->
        <Grid
            BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
            Margin="0,-40,0,-30"
            Grid.Row="0"
            grial:Effects.CornerRadius="{ DynamicResource CornerRadius-lg }"
            InputTransparent="True">
            <VisualElement.Behaviors>
                <!-- Keeps the carousel on top -->
                <grial:AnimatedTranslationY
                    Easing="Linear"
                    Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                    ProgressStart="0"
                    ProgressEnd="240"
                    Start="0"
                    MultiplyValue="-1"
                    End="240"
                />

                <!-- Make the carousel receive user inputs when it's small and behaves as a carousel -->
                <grial:AnimatedInputTransparent
                    Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                    Threshold="240"
                    ValueBeforeThreshold="True"
                />
            </VisualElement.Behaviors>

            <local:ExtendedCarouselView
                IndicatorView="indicatorView"
                Loop="True"
                Position="{ Binding Featured.Position, Mode=TwoWay }"
                ItemsSource="{ Binding Featured.Movies }"
                HorizontalScrollBarVisibility="Never"
                IsBounceEnabled="False">
                <VisualElement.Behaviors>
                    <grial:AnimatedInputTransparent
                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                        Threshold="240"
                        ValueBeforeThreshold="True"
                    />
                </VisualElement.Behaviors>

                <CarouselView.ItemTemplate>
                    <!-- Featured movie template -->
                    <DataTemplate>
                        <Grid
                            BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
                            IsClippedToBounds="{ OnPlatform iOS=true }"
                            ColumnDefinitions="*,*">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid.Resources>
                                <ResourceDictionary>
                                    <grial:AnimationFadeTo
                                        x:Key="TextsFadeIn"
                                        Target="{ x:Reference Texts }"
                                        Duration="150"
                                        Opacity="1"
                                    />

                                    <grial:AnimationFadeTo
                                        x:Key="TextsFadeOut"
                                        Target="{ x:Reference Texts }"
                                        Duration="150"
                                        Opacity="0"
                                    />
                                </ResourceDictionary>
                            </Grid.Resources>
                            <!-- ORIGINAL TITLE -->
                            <Grid
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="{ grial:OnOrientationThickness
                                    Landscape='0,40,0,0',
                                    Portrait='0,100,0,0'
                                }"
                                VerticalOptions="Start"
                                HorizontalOptions="Center"
                                RowSpacing="5"
                                RowDefinitions="Auto,Auto">
                                <VisualElement.Behaviors>
                                    <!-- Hides original title -->
                                    <grial:AnimatedOpacity
                                        Easing="CubicIn"
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        ProgressStart="0"
                                        ProgressEnd="60"
                                        Start="1"
                                        MultiplyValue="1"
                                        End="0"
                                    />
                                    <grial:AnimatedTranslationY
                                        Easing="Linear"
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        ProgressStart="0"
                                        ProgressEnd="60"
                                        Start="0"
                                        MultiplyValue="1"
                                        End="60"
                                    />
                                </VisualElement.Behaviors>

                                <Label
                                    Grid.Row="1"
                                    FontSize="20"
                                    TextColor="{ DynamicResource TextColor }"
                                    Text="{ Binding Name }"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                />

                                <Label
                                    Grid.Row="0"
                                    FontSize="14"
                                    TextColor="{ DynamicResource PrimaryColor }"
                                    Text="{ Binding Year }"
                                    FontAttributes="Italic"
                                    HorizontalOptions="Center"
                                />
                            </Grid>

                            <!-- MOVIE POSTER -->
                            <Grid
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                VerticalOptions="End"
                                HorizontalOptions="Center"
                                WidthRequest="200"
                                HeightRequest="310"
                                Margin="0,30"
                                x:Name="Poster"
                                grial:Effects.DropShadow="{ OnPlatform iOS=Light }">
                                <VisualElement.Behaviors>
                                    <grial:AnimatedScale
                                        Easing="SinOut"
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        ProgressStart="0"
                                        ProgressEnd="240"
                                        Start="1"
                                        MultiplyValue="1"
                                        End="0.45"
                                    />
                                    <grial:AnimatedTranslationY
                                        Easing="Linear"
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        ProgressStart="0"
                                        ProgressEnd="240"
                                        Start="0"
                                        MultiplyValue="1"
                                        End="75"
                                    />
                                    <grial:AnimatedAction
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        Threshold="270"
                                        InvokeActionWhen="AfterThreshold">
                                        <grial:AnimationTranslateX
                                            Target="{ x:Reference Poster }"
                                            Duration="150"
                                            TranslateX="-110"
                                        />
                                    </grial:AnimatedAction>

                                    <grial:AnimatedAction
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        Threshold="270"
                                        InvokeActionWhen="BeforeThreshold">
                                        <grial:AnimationTranslateX
                                            Target="{ x:Reference Poster }"
                                            Duration="100"
                                            TranslateX="0"
                                        />
                                    </grial:AnimatedAction>
                                </VisualElement.Behaviors>

                                <Image
                                    Source="{ Binding PosterImage }"
                                    grial:Effects.CornerRadius="{ DynamicResource BaseCornerRadius }"
                                    Style="{ OnPlatform Android={StaticResource BlurredShadow} }"
                                    HeightRequest="{ OnIdiom
                                        Phone='270',
                                        Tablet='400'
                                    }"
                                    WidthRequest="{ OnIdiom
                                        Phone='175',
                                        Tablet='200'
                                    }"
                                />

                            </Grid>

                            <!-- TITLE, DATE, DETAIL BUTTON -->
                            <Grid
                                x:Name="Texts"
                                RowDefinitions="Auto,Auto,Auto"
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="Start"
                                VerticalOptions="End"
                                TranslationY="-65"
                                TranslationX="-30"
                                Opacity="0">
                                <VisualElement.Behaviors>

                                    <grial:AnimatedAction
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        Threshold="270"
                                        InvokeActionWhen="AfterThreshold">
                                        <grial:AnimationFadeTo
                                            Target="{ x:Reference Texts }"
                                            Duration="150"
                                            Opacity="1"
                                        />
                                    </grial:AnimatedAction>

                                    <grial:AnimatedAction
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        Threshold="270"
                                        InvokeActionWhen="AfterThreshold">
                                        <grial:AnimationTranslateTo
                                            Target="{ x:Reference Texts }"
                                            Duration="150"
                                            TranslateX="-30"
                                            TranslateY="-65"
                                        />
                                    </grial:AnimatedAction>

                                    <grial:AnimatedAction
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        Threshold="270"
                                        InvokeActionWhen="BeforeThreshold">
                                        <grial:AnimationTranslateTo
                                            Target="{ x:Reference Texts }"
                                            Duration="100"
                                            TranslateX="100"
                                            TranslateY="-65"
                                        />
                                    </grial:AnimatedAction>

                                    <grial:AnimatedAction
                                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                                        Threshold="270"
                                        InvokeActionWhen="BeforeThreshold">
                                        <grial:AnimationFadeTo
                                            Target="{ x:Reference Texts }"
                                            Duration="100"
                                            Opacity="0"
                                        />
                                    </grial:AnimatedAction>

                                </VisualElement.Behaviors>

                                <Label
                                    FontSize="16"
                                    TextColor="{ DynamicResource TextColor }"
                                    Text="{ Binding Name }"
                                    HorizontalOptions="Start"
                                    FontAttributes="Bold"
                                />

                                <Label
                                    Grid.Row="1"
                                    FontSize="12"
                                    TextColor="{ DynamicResource TextSecondaryColor }"
                                    Text="{ Binding Year }"
                                    FontAttributes="Italic"
                                    HorizontalOptions="Start"
                                    LineBreakMode="WordWrap"
                                />

                                <Button
                                    Grid.Row="2"
                                    Margin="0,10,0,0"
                                    WidthRequest="120"
                                    HeightRequest="34"
                                    CornerRadius="{ DynamicResource CornerRadiusInt-md }"
                                    Text="{ grial:Translate MovieDetails }"
                                    Clicked="OnFeatured"
                                    BorderColor="{ DynamicResource PrimaryColor }"
                                    FontSize="11"
                                    TextColor="{ DynamicResource PrimaryColor }"
                                    HorizontalOptions="Start"
                                    Style="{ StaticResource OutlineButtonStyle }"
                                />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </local:ExtendedCarouselView>

            <IndicatorView
                x:Name="indicatorView"
                HorizontalOptions="Center"
                VerticalOptions="End"
                IndicatorColor="{ DynamicResource TextSecondaryColor }"
                SelectedIndicatorColor="{ DynamicResource PrimaryColor }"
                Margin="0,0,0,10">
                <VisualElement.Behaviors>
                    <!-- Make the carousel show dot indicators when behaves as a carousel -->
                    <grial:AnimatedIsVisible
                        Progress="{ Binding AbsoluteScrollY, Source={x:Reference scroll} }"
                        Threshold="240"
                        ValueBeforeThreshold="False"
                    />
                </VisualElement.Behaviors>
            </IndicatorView>
        </Grid>

    </Grid>
</ContentPage>