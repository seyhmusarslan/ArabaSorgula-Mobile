<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.ChatMessagesListPage"
    Title="{ grial:Translate PageTitleChatMessagesList }"
    grial:Effects.ApplyIOSSafeAreaAsPadding="Bottom"
    grial:Effects.IOSSafeAreaBottomSize="20"
    BackgroundColor="{ DynamicResource BackgroundSecondaryColor }">

    <ContentPage.Resources>
        <ResourceDictionary>
            <grial:BoolMemberTemplateSelector
                x:Key="Selector"
                MemberName="IsInbound">

                <grial:BoolMemberTemplateSelector.TrueDataTemplate>
                    <DataTemplate>
                        <local:ChatLeftMessageItemTemplate />
                    </DataTemplate>
                </grial:BoolMemberTemplateSelector.TrueDataTemplate>

                <grial:BoolMemberTemplateSelector.FalseDataTemplate>
                    <DataTemplate>
                        <local:ChatRightMessageItemTemplate />
                    </DataTemplate>
                </grial:BoolMemberTemplateSelector.FalseDataTemplate>

            </grial:BoolMemberTemplateSelector>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid
        BackgroundColor="{ DynamicResource BackgroundColor }"
        Grid.Column="0"
        RowSpacing="0"
        RowDefinitions="*,Auto">

        <CollectionView
            BackgroundColor="{ DynamicResource BackgroundColor }"
            VerticalScrollBarVisibility="Never"
            Grid.Row="0"
            ItemsSource="{ Binding Messages }"
            ItemTemplate="{ StaticResource Selector }"
            Style="{ StaticResource ResponsiveLandscapeMarginStyle }">
            <CollectionView.Footer>
                <BoxView HeightRequest="20" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- - BUTTONS CONTAINER -->
        <grial:ExtendedGrid
            Grid.Row="1"
            Padding="10,0"
            ColumnSpacing="5"
            ColumnDefinitions="40,*,40"
            Margin="0,-40,0,0"
            TrimTopShape="InvertedRoundedCorners"
            TrimTopHeight="40"
            BackgroundColor="{ DynamicResource BackgroundSecondaryColor }">
            <!-- - PICTURE BUTTON -->
            <Label
                Grid.Column="0"
                TextColor="{ DynamicResource PrimaryColor }"
                FontSize="24"
                HorizontalOptions="Center"
                Style="{ StaticResource ChatIconButtonBaseStyle }"
                Text="{ x:Static local:GrialIconsFont.Plus }"
            />

            <!-- - ENTRY -->
            <Entry
                Grid.Column="1"
                Margin="0,10"
                Placeholder="{ grial:Translate TypeYourMessage }"
                grial:EntryProperties.BorderColor="{ DynamicResource EntryAndEditorsBorderColor }"
                BackgroundColor="{ DynamicResource EntryAndEditorsBackgroundColor }"
                grial:EntryProperties.BorderWidth="2"
                grial:EntryProperties.BorderCornerRadius="{ DynamicResource EntryBorderCornerRadius }"
            />

            <!-- - SEND BUTTON -->
            <Label
                Grid.Column="2"
                FontSize="24"
                HorizontalOptions="Center"
                TextColor="{ DynamicResource PrimaryColor }"
                Style="{ StaticResource ChatIconButtonBaseStyle }"
                Text="{ x:Static local:GrialIconsFont.Camera }"
            />
        </grial:ExtendedGrid>
    </Grid>
</ContentPage>
