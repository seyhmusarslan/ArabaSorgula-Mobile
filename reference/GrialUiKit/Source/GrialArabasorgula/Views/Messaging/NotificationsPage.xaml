<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.NotificationsPage"
    Title="{ grial:Translate PageTitleNotifications }"
    BackgroundColor="{ DynamicResource BackgroundColor }">
    <CollectionView
        Margin="0,10"
        ItemsSource="{ Binding Notifications }">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid
                    HeightRequest="{ OnIdiom
                        Phone=80,
                        Tablet=90
                    }"
                    RowSpacing="0"
                    RowDefinitions="*,1">

                    <local:NotificationsListItemTemplate />

                    <!-- SEPARATOR -->
                    <BoxView
                        Grid.Row="1"
                        IsVisible="False"
                        Style="{ StaticResource Horizontal1ptLineStyle }"
                    />

                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
