<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.RecentChatListPage"
    BackgroundColor="{ DynamicResource BackgroundColor }"
    Title="{ grial:Translate PageTitleRecentChatList }">

    <CollectionView ItemsSource="{ Binding Messages }">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid
                    RowDefinitions="*,1"
                    RowSpacing="0">
                    <local:RecentChatItemTemplate HeightRequest="{ OnIdiom Phone=80, Tablet=100 }" />

                    <!-- SEPARATOR -->
                    <BoxView
                        Grid.Row="1"
                        IsVisible="False"
                        VerticalOptions="End"
                        Style="{ StaticResource Horizontal1ptLineStyle }"
                    />

                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>