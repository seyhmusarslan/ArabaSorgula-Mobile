<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.EventListItemTemplate">

    <grial:DrawerScrollView VerticalScrollBarVisibility="Never">
        <Grid
            RowDefinitions="Auto,*"
            RowSpacing="10">
            <!-- TITLE -->
            <Label
                FontAttributes="Bold"
                Text="{ Binding SelectedDate, StringFormat='{}{0:dd MMM yyyy}' }"
                FontSize="{ OnIdiom
                    Phone='18',
                    Tablet='20'
                }"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Start"
            />

            <!-- LIST -->
            <grial:DrawerCollectionView
                Grid.Row="1"
                ItemsSource="{ Binding EventList }"
                Margin="{ OnPlatform
                    iOS='0,20,0,50',
                    Android='0,20,0,30'
                }">
                <grial:DrawerCollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="16"
                    />
                </grial:DrawerCollectionView.ItemsLayout>

                <grial:DrawerCollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Card Template -->
                        <Grid
                            Padding="20"
                            ColumnSpacing="16"
                            BackgroundColor="{ Binding BackgroundColor }"
                            grial:Effects.CornerRadius="{ DynamicResource BaseCornerRadius }"
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="Auto,*">
                            <!-- Icon -->
                            <local:RoundedIcon
                                Grid.RowSpan="2"
                                IconText="{ Binding Icon }"
                                IconColor="{ DynamicResource OnSurfaceColor }"
                                IconFontFamily="Lucide"
                                IconFontSize="18"
                                IconBackgroundColor="{ DynamicResource OverlayHighlightColor }"
                                IconBackgroundCornerRadius="{ DynamicResource CornerRadius-md }"
                                HeightRequest="42"
                                WidthRequest="42"
                                VerticalOptions="Center"
                            />
                            <!-- Activity -->
                            <Label
                                Grid.Column="1"
                                Text="{ Binding Activity }"
                                TextColor="{ DynamicResource OnSurfaceColor }"
                                FontSize="{ StaticResource LargeFontSize }"
                                VerticalOptions="Center"
                            />

                            <!-- When -->
                            <Label
                                Grid.Column="1"
                                Grid.Row="1"
                                TextColor="{ DynamicResource OnSurfaceColor }"
                                VerticalOptions="Center"
                                FontSize="{ StaticResource SmallFontSize }">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{ Binding Date }" />
                                        <Span Text=", " />
                                        <Span Text="{ Binding Time }" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </grial:DrawerCollectionView.ItemTemplate>

            </grial:DrawerCollectionView>
        </Grid>
    </grial:DrawerScrollView>
</ContentView>
