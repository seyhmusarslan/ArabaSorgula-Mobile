<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.WizardRadioItemTemplate">

    <!-- Radio -->
    <VerticalStackLayout
        RadioButtonGroup.SelectedValue="{ Binding Value, Mode=TwoWay }"
        RadioButtonGroup.GroupName="Group1"
        Spacing="5"
        BindableLayout.ItemsSource="{ Binding Options }">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <RadioButton
                    Style="{ DynamicResource DefaultRadioStyle }"
                    GroupName="Group1"
                    Content="{ Binding . }"
                    Value="{ Binding . }"
                />
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>

</ContentView>

