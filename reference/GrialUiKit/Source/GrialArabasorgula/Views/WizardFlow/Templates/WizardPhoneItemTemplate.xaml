<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.WizardPhoneItemTemplate"
    x:Name="root">
    <Grid>

        <!-- Entry -->
        <Entry
            x:Name="entry"
            Placeholder="{ Binding HintText }"
            Keyboard="Telephone"
            grial:EntryProperties.HorizontalPadding="60"
            Text="{ Binding Value, Mode=TwoWay }"
            BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
            grial:EntryProperties.BorderStyle="RoundRect"
            grial:EntryProperties.BorderColor="{ DynamicResource EntryAndEditorsBackgroundColor }"
            grial:EntryProperties.BorderWidth="1"
        />

        <!-- Country Flag -->
        <local:Emoji
            WidthRequest="34"
            HeightRequest="34"
            Unicode="{ Binding Country.Value.Flag }"
            HorizontalOptions="Start"
            Margin="16,0,0,0"
            VerticalOptions="Center"
            InputTransparent="true"
        />

        <!-- Success Check Icon -->
        <Label
            FontSize="20"
            HorizontalTextAlignment="End"
            InputTransparent="True"
            Style="{ StaticResource FontIconFill }"
            Text="{ x:Static local:GrialIconsFont.CheckCircle }"
            TextColor="{ DynamicResource SuccessColor }"
            IsVisible="{ Binding IsValid }"
            VerticalOptions="Center"
            Margin="17"
        />
    </Grid>

</ContentView>
