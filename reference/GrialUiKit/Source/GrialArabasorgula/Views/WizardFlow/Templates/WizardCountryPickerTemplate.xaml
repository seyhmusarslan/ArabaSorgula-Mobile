<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.WizardCountryPickerTemplate">

    <Frame
        BorderColor="{ DynamicResource EntryAndEditorsBackgroundColor }"
        HasShadow="False"
        BackgroundColor="Transparent"
        CornerRadius="{ DynamicResource CornerRadiusFloat-big }"
        HeightRequest="54"
        Padding="0"
        VerticalOptions="FillAndExpand"
        HorizontalOptions="FillAndExpand">
        <Grid
            ColumnDefinitions="Auto,*,30"
            Padding="20,0"
            HorizontalOptions="FillAndExpand">

            <!-- Flag -->
            <local:Emoji
                Grid.Column="0"
                WidthRequest="34"
                Unicode="{ Binding Value.Flag }"
                HorizontalOptions="Center"
                Margin="0,10,10,10"
                IsVisible="False"
            />

            <!-- Text -->
            <Label
                Grid.Column="1"
                Text="{ Binding HintText }"
                VerticalOptions="Center"
                HorizontalOptions="FillAndExpand"
                IsVisible="{ grial:Not
                    Condition={Binding
                        IsVisible,
                        Source={x:Reference text}
                    }
                }"
            />

            <!-- Value -->
            <Label
                x:Name="text"
                Grid.Column="1"
                Text="{ Binding Value.Name }"
                VerticalOptions="Center"
                HorizontalOptions="FillAndExpand"
                IsVisible="{ Binding Value, Converter={StaticResource IsNotNullConverter} }"
            />

            <!-- Chevron -->
            <Label
                Grid.Column="2"
                Text="{ x:Static local:GrialIconsFont.ChevronRight }"
                FontFamily="{ StaticResource IconsFontFamily }"
                FontSize="20"
                HorizontalOptions="End"
                VerticalOptions="Center"
            />
        </Grid>

        <Frame.GestureRecognizers>
            <TapGestureRecognizer Command="{ Binding ShowCountriesCommand }" />
        </Frame.GestureRecognizers>
    </Frame>

</ContentView>

