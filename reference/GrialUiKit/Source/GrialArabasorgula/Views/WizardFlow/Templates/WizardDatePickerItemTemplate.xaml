<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.WizardDatePickerItemTemplate">

    <!-- Date picker -->
    <DatePicker
        Date="{ Binding Value, Mode=TwoWay }"
        Format="MM/dd/yyyy"
        BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
        grial:PickerProperties.BorderStyle="RoundRect"
        grial:PickerProperties.BorderColor="{ DynamicResource EntryAndEditorsBackgroundColor }"
        grial:PickerProperties.BorderWidth="1"
    />

</ContentView>

