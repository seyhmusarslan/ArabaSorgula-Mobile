<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.WizardEntryItemTemplate">

    <!-- Entry -->
    <Entry
        Placeholder="{ Binding HintText }"
        Text="{ Binding Value, Mode=TwoWay }"
        BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
        grial:EntryProperties.BorderStyle="RoundRect"
        grial:EntryProperties.BorderColor="{ DynamicResource EntryAndEditorsBackgroundColor }"
        grial:EntryProperties.BorderWidth="1"
    />

</ContentView>

