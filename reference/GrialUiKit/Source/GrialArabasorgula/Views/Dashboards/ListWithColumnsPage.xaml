<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ListWithColumnsPage"
    Title="Navigation List With Columns"
    x:Name="root"
    BackgroundColor="{ DynamicResource BackgroundColor }">
    <ScrollView>
        <grial:GridView
            ItemsSource="{ Binding Items }"
            ColumnCount="2"
            Padding="16"
            ColumnSpacing="16"
            RowSpacing="16">
            <grial:GridView.ItemTemplate>
                <DataTemplate>
                    <local:ListWithColumnsItemTemplate
                        grial:Effects.CornerRadius="{ DynamicResource BaseCornerRadius }"
                        HeightRequest="130">
                        <View.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{ Binding BindingContext.TapCommand, Source={x:Reference root} }"
                                CommandParameter="{ Binding . }"
                            />
                        </View.GestureRecognizers>
                    </local:ListWithColumnsItemTemplate>
                </DataTemplate>
            </grial:GridView.ItemTemplate>
        </grial:GridView>
    </ScrollView>
</ContentPage>

