<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ListWithColumnsItemVariantTemplate"
    x:Name="root"
    BackgroundColor="{ DynamicResource BackgroundSecondaryColor }">
    <Grid
        ColumnSpacing="20"
        RowSpacing="0"
        BackgroundColor="{ DynamicResource BackgroundSecondaryColor }">

        <Grid
            RowDefinitions="*,*"
            RowSpacing="15">

            <!-- ICON IMAGE -->
            <local:RoundedIcon
                HeightRequest="40"
                WidthRequest="40"
                Margin="20,25,20,0"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                IconBackgroundColor="{ Binding BackgroundColorColor }"
                IconBackgroundCornerRadius="{ DynamicResource CornerRadius-md }"
                IconText="{ Binding Icon }"
                IconFontSize="24"
                IconColor="{ DynamicResource OnSurfaceColor }"
            />

            <!-- TEXTS -->
            <VerticalStackLayout
                Spacing="0"
                Grid.Row="1"
                Margin="20,0">
                <Label
                    VerticalTextAlignment="Center"
                    LineHeight="1.2"
                    Text="{ Binding Name }"
                    HorizontalOptions="Center"
                    TextColor="{ DynamicResource TextColor }"
                />

                <Label
                    VerticalTextAlignment="Center"
                    LineHeight="1.2"
                    Text="{ Binding ItemCount, StringFormat='{}{0:F0} items' }"
                    FontAttributes="None"
                    FontSize="11"
                    HorizontalOptions="Center"
                    TextColor="{ DynamicResource TextColor }"
                />
            </VerticalStackLayout>
        </Grid>


    </Grid>
</ContentView>