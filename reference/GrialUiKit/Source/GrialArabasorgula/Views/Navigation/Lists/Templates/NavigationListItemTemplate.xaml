<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.NavigationListItemTemplate">

    <grial:CardView
        BackgroundColor="{ Binding BackgroundColorColor }"
        HasShadow="False"
        Margin="30,8"
        ColumnSpacing="4"
        RowSpacing="5"
        RowDefinitions="*,*">

        <grial:CardView.ColumnDefinitions>
            <ColumnDefinition Width="{ OnIdiom Phone=80, Tablet=110 }" />
            <ColumnDefinition Width="*" />
        </grial:CardView.ColumnDefinitions>

        <!-- ICON -->
        <local:RoundedIcon
            Margin="10"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            IconHorizontalOptions="Center"
            IconVerticalOptions="Center"
            IconText="{ Binding Icon }"
            IconBackgroundCornerRadius="{ DynamicResource CornerRadius-md }"
            IconBackgroundColor="White"
            IconColor="White"
            IconPadding="14"
            IconBackgroundOpacity="0.1"
            IconFontSize="20"
        />

        <Label
            Grid.Column="1"
            Grid.Row="0"
            Text="{ Binding Name }"
            TextColor="{ DynamicResource OnSurfaceColor }"
            HorizontalOptions="Start"
            VerticalTextAlignment="End"
        />

        <Label
            Grid.Column="1"
            Grid.Row="1"
            Text="{ Binding ItemCount, StringFormat='{}{0:F0} items' }"
            FontAttributes="None"
            TextColor="{ DynamicResource OnSurfaceColor }"
            FontSize="14"
            Opacity=".5"
            HorizontalOptions="Start"
            VerticalTextAlignment="Start"
        />
    </grial:CardView>

</ContentView>
