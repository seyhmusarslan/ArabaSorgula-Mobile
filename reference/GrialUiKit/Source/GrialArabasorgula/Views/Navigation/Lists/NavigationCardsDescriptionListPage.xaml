<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    BackgroundColor="{ DynamicResource BackgroundColor }"
    x:Class="arabasorgula.NavigationCardsDescriptionListPage">
    <!-- CONTENT -->
    <Grid
        RowDefinitions="Auto,*"
        RowSpacing="0"
        Style="{ StaticResource ResponsiveLandscapeMarginStyle }">

        <!-- HEADER -->
        <Grid
            Margin="30,35,30,0"
            ColumnSpacing="12"
            RowSpacing="0"
            ColumnDefinitions="Auto,*"
            RowDefinitions="Auto">

            <!-- TITLE -->
            <Label
                Grid.Column="0"
                FontSize="24"
                Text="{ Binding Category.Name }"
                TextColor="{ DynamicResource TextColor }"
            />

            <!-- ICON -->
            <local:Emoji
                Grid.Column="1"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Unicode="{ Binding Category.Emoji }"
            />

        </Grid>

        <!-- LIST -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{ Binding Items }"
            SelectedItem="{ Binding SelectedItem, Mode=TwoWay }"
            SelectionMode="Single"
            Margin="0,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <local:NavigationCardsDescriptionListItemTemplate />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
