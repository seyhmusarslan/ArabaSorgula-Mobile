<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.NavigationFlatListPage"
    Title="{ grial:Translate PageTitleNavigationFlatList }"
    BackgroundColor="{ DynamicResource BackgroundColor }">

    <CollectionView
        Style="{ StaticResource ResponsiveLandscapeMarginStyle }"
        ItemsSource="{ Binding Items }"
        SelectedItem="{ Binding SelectedItem, Mode=TwoWay }">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <local:NavigationListItemTemplate HeightRequest="{ OnIdiom Phone=100, Tablet=120 }" />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>