<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.TabControlCustomSamplePage"
    Title="{ grial:Translate PageTitleTabControlCustomSample }">

    <ContentPage.Resources>
        <ResourceDictionary Source="/Styles/TabControl/CustomTabResources.xaml" />
    </ContentPage.Resources>

    <!-- Custom Tabs -->
    <grial:TabControl
        Style="{ StaticResource CustomTabStyle }"
        TabContentBackgroundColor="{ DynamicResource BackgroundColor }"
        TabStripBackgroundColor="{ DynamicResource BackgroundSecondaryColor }">

        <!-- HOME TAB -->
        <grial:TabItem IconText="{ x:Static local:GrialIconsFont.Home }">
            <Grid RowDefinitions="*,Auto">

                <Grid
                    Grid.Row="0"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    RowDefinitions="6*,4*">

                    <!-- ICON -->
                    <Label
                        Grid.Row="0"
                        Text="{ x:Static local:GrialIconsFont.CheckCircle }"
                        Style="{ StaticResource FontIcon }"
                        FontSize="70"
                        VerticalTextAlignment="End"
                        HorizontalTextAlignment="Center"
                        TextColor="{ DynamicResource SuccessColor }"
                        VerticalOptions="End"
                        HorizontalOptions="Center"
                    />

                    <!-- TEXT -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        Margin="0,30,0,0"
                        VerticalOptions="Start"
                        Padding="60,0"
                        Spacing="2">
                        <Label
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center"
                            Text="{ grial:Translate StringHelloClare }"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="{ DynamicResource TextColor }"
                        />

                        <Label
                            HorizontalTextAlignment="Center"
                            Opacity="0.8"
                            Text="{ grial:Translate StringNoPendingTasksToday }"
                            FontSize="18"
                            TextColor="{ DynamicResource TextColor }"
                        />
                    </VerticalStackLayout>

                </Grid>

                <!-- BUTTON -->
                <Button
                    Grid.Row="1"
                    Style="{ StaticResource PrimaryActionButtonStyle }"
                    BackgroundColor="{ DynamicResource PrimaryColor }"
                    VerticalOptions="End"
                    Text="{ grial:Translate StringDone }"
                    Margin="{ DynamicResource AirSpacing }"
                    WidthRequest="{ grial:OnOrientationSizeRequest
                        LandscapePhone=200,
                        LandscapeTablet=400
                    }"
                    HorizontalOptions="{ grial:OnOrientationLayoutOptions
                        PortraitPhone=Fill,
                        LandscapePhone=Center,
                        PortraitTablet=Fill,
                        LandscapeTablet=Center
                    }"
                />
            </Grid>

        </grial:TabItem>

        <!-- FRIENDS TAB -->
        <grial:TabItem
            BadgeText="7"
            IconText="{ x:Static local:GrialIconsFont.Users }">

            <CollectionView
                VerticalScrollBarVisibility="Never"
                Style="{ StaticResource ResponsiveLandscapeMarginStyle }"
                ItemsSource="{ Binding Timeline.TimelineList }">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <local:TimelineItemTemplate Padding="{ StaticResource MainWrapperPadding }" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </grial:TabItem>

        <!-- USER TAB -->
        <grial:TabItem
            IconImage="https://d3nz6a95rn0zd2.cloudfront.net/v4.0/rounded_friend.png"
            IconImageSelected="https://d3nz6a95rn0zd2.cloudfront.net/v4.0/rounded_friend_selected.png">
            <!-- USER PROFILE -->
            <Grid
                RowSpacing="0"
                RowDefinitions="200,*">

                <!-- IMAGE HEADER BG -->
                <Grid Grid.Row="0">
                    <Image
                        Aspect="AspectFill"
                        Source="https://d3nz6a95rn0zd2.cloudfront.net/v4.0/category_01.jpg"
                        VerticalOptions="Start"
                        BackgroundColor="Black"
                        Opacity="1"
                        HeightRequest="200"
                    />

                    <local:AvatarWithStatus
                        BorderSize="0"
                        CornerRadius="{ DynamicResource BaseCornerRadiusDouble }"
                        Source="https://d3nz6a95rn0zd2.cloudfront.net/v4.0/article_01.jpg"
                        HeightRequest="90"
                        WidthRequest="90"
                        VerticalOptions="Start"
                        HorizontalOptions="Center"
                        TranslationY="35"
                        StatusIndicatorText="10+"
                        StatusIndicatorTextColor="{ DynamicResource OnSurfaceColor }"
                        StatusIndicatorColor="#22c064"
                        StatusIndicatorShift="10"
                    />

                    <!-- Name -->
                    <Label
                        Text="{ grial:Translate StringClareJapi }"
                        TextColor="{ DynamicResource OnSurfaceColor }"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        FontSize="{ grial:OnOrientationDouble
                            PortraitPhone=18,
                            LandscapePhone=18,
                            PortraitTablet=22,
                            LandscapeTablet=22
                        }"
                        FontAttributes="Bold"
                        TranslationY="-25"
                    />
                </Grid>

                <!-- SOCIAL IMAGE GALLERY GRID -->
                <grial:GridView
                    Grid.Row="1"
                    Padding="10"
                    ColumnSpacing="10"
                    RowSpacing="10"
                    VerticalOptions="Fill"
                    ColumnCount="3"
                    RowCount="3"
                    ItemsSource="{ Binding Social.Related.Images }">
                    <grial:GridView.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{ Binding . }" />
                        </DataTemplate>
                    </grial:GridView.ItemTemplate>
                </grial:GridView>
            </Grid>

        </grial:TabItem>

        <!-- CHAT TAB -->
        <grial:TabItem
            BadgeText="5+"
            IconText="{ x:Static local:GrialIconsFont.MessagesCircle }">
            <CollectionView ItemsSource="{ Binding Chat.Messages }">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="*,1">
                            <local:RecentChatItemTemplate HeightRequest="{ OnIdiom Phone=80, Tablet=100 }" />

                            <!-- SEPARATOR -->
                            <BoxView
                                Grid.Row="1"
                                IsVisible="False"
                                Style="{ DynamicResource Horizontal1ptLineStyle }"
                            />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </grial:TabItem>

        <!-- SETTINGS TAB -->
        <grial:TabItem
            BadgeText="2"
            IconText="{ x:Static local:GrialIconsFont.Settings }">
            <Grid
                Padding="40"
                VerticalOptions="Fill"
                RowSpacing="10"
                ColumnDefinitions="*,Auto"
                RowDefinitions="50,Auto,Auto,*">

                <Label
                    Text="{ grial:Translate StringConnectYourAccount }"
                    FontAttributes="Bold"
                    FontSize="20"
                />

                <Label
                    Text="{ grial:Translate StringFacebook }"
                    Grid.Row="1"
                    FontSize="15"
                    VerticalOptions="Center"
                />
                <Switch
                    Grid.Row="1"
                    Grid.Column="1"
                    IsToggled="True"
                />

                <Label
                    Text="{ grial:Translate StringTwitter }"
                    Grid.Row="2"
                    FontSize="15"
                    VerticalOptions="Center"
                />
                <Switch
                    Grid.Row="2"
                    Grid.Column="1"
                />

                <VerticalStackLayout
                    VerticalOptions="End"
                    Grid.Row="3"
                    Grid.ColumnSpan="2">
                    <Button
                        Style="{ StaticResource SecondaryActionButtonStyle }"
                        Text="{ grial:Translate StringSaveChanges }"
                        WidthRequest="{ grial:OnOrientationSizeRequest
                            LandscapePhone=200,
                            LandscapeTablet=400
                        }"
                        HorizontalOptions="{ grial:OnOrientationLayoutOptions
                            PortraitPhone=Fill,
                            LandscapePhone=Center,
                            PortraitTablet=Fill,
                            LandscapeTablet=Center
                        }"
                    />
                </VerticalStackLayout>
            </Grid>
        </grial:TabItem>
    </grial:TabControl>
</ContentPage>