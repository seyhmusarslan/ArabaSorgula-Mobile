<?xml version="1.0" encoding="utf-8" ?>
<uxd:PopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:uxd="clr-namespace:UXDivers.Popups.Maui;assembly=UXDivers.Popups.Maui"
    x:Class="arabasorgula.SmartHomeAirSchedulePopup"
    Background="{ DynamicResource OverlayColor }"
    CloseWhenBackgroundIsClicked="True">

    <uxd:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:DialogsResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </uxd:PopupPage.Resources>

    <Grid
        Margin="20"
        Style="{ StaticResource BlurredShadow }"
        VerticalOptions="{ DynamicResource DialogsVerticalPositioning }">
        <Grid
            RowSpacing="0"
            Padding="{ DynamicResource AirSpacing }"
            BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
            grial:Effects.CornerRadius="{ StaticResource DialogsCornerRadius }"
            RowDefinitions="*,Auto">

            <ScrollView
                VerticalScrollBarVisibility="Never"
                HorizontalScrollBarVisibility="Never">
                <!-- CONTENT -->
                <VerticalStackLayout
                    Margin="0"
                    Grid.Row="0"
                    Spacing="20">

                    <!-- TITLE -->
                    <Label
                        HorizontalOptions="Start"
                        Text="{ grial:Translate LabelDeviceSchedule }"
                        FontSize="{ OnPlatform
                            iOS=20,
                            Android=18
                        }"
                    />

                    <!-- SCHEDULE -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{ grial:Translate LabelRoomTemperature }"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                        />
                        <Label
                            Grid.Column="1"
                            Text="{ Binding Temperature, StringFormat='{0:F0} °F' }"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center"
                        />
                    </Grid>

                    <!-- Schedule Name -->
                    <grial:Slider
                        Style="{ StaticResource TallSliderStyle }"
                        Margin="0,-10,0,0"
                        MinValue="60"
                        MaxValue="90"
                        Value="{ Binding Temperature }"
                    />

                    <!-- AIR CONDITIONER MODES -->
                    <FlexLayout
                        BindableLayout.ItemsSource="{ Binding AirModes }"
                        RadioButtonGroup.SelectedValue="{ Binding Mode, Mode=TwoWay }"
                        RadioButtonGroup.GroupName="functions"
                        HorizontalOptions="Fill"
                        JustifyContent="SpaceBetween"
                        AlignContent="Start"
                        AlignItems="Start"
                        Direction="Row">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <local:SmartHomeACSettingsRadioButtonTemplate />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Title -->
                    <Label Text="{ grial:Translate LabelFanSpeed }" />

                    <!-- Speed Selection -->
                    <grial:SelectableWrapPanel
                        ItemsSource="{ Binding AirSpeeds }"
                        SelectedItem="{ Binding Speed, Mode=TwoWay }"
                        SelectionMode="Single"
                        HorizontalOptions="Fill"
                        ColumnSpacing="10">

                        <grial:SelectableWrapPanel.ItemTemplate>
                            <DataTemplate>
                                <grial:RoundedLabel
                                    Text="{ Binding . }"
                                    TextColor="{ DynamicResource TextSecondaryColor }"
                                    HeightRequest="{ OnPlatform Android=30 }"
                                    FontSize="14"
                                    BackgroundColor="{ DynamicResource BackgroundColor }"
                                    Padding="8,6"
                                />
                            </DataTemplate>
                        </grial:SelectableWrapPanel.ItemTemplate>

                        <grial:SelectableWrapPanel.SelectedItemTemplate>
                            <DataTemplate>
                                <grial:RoundedLabel
                                    Text="{ Binding . }"
                                    TextColor="{ DynamicResource PrimaryActionButtonTextColor }"
                                    HeightRequest="{ OnPlatform Android=30 }"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{ DynamicResource PrimaryColor }"
                                    Padding="8,6"
                                />
                            </DataTemplate>
                        </grial:SelectableWrapPanel.SelectedItemTemplate>
                    </grial:SelectableWrapPanel>

                    <!-- Schedule Settings -->
                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="*,Auto"
                        ColumnSpacing="20"
                        RowSpacing="10">

                        <Label
                            Text="{ grial:Translate LabelFrom }"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                        />
                        <TimePicker
                            Grid.Row="1"
                            Time="{ Binding From }"
                        />

                        <Label
                            Grid.Column="1"
                            Text="{ grial:Translate LabelTo }"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                        />
                        <TimePicker
                            Grid.Row="1"
                            Grid.Column="1"
                            Time="{ Binding To }"
                        />
                    </Grid>

                    <!-- When -->
                    <VerticalStackLayout Spacing="15">
                        <Label
                            Text="{ grial:Translate LabelWhen }"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                        />

                        <!-- FREQUENCY SELECTION -->
                        <!-- Day Groups -->
                        <grial:SelectableWrapPanel
                            x:Name="wrap"
                            ItemsSource="{ Binding FrequencyMulti }"
                            SelectedItem="{ Binding When, Mode=TwoWay }"
                            SelectionMode="Single"
                            HorizontalOptions="Start"
                            ColumnSpacing="0">

                            <grial:SelectableWrapPanel.ItemTemplate>
                                <DataTemplate>
                                    <grial:RoundedLabel
                                        Text="{ Binding . }"
                                        TextColor="{ DynamicResource TextSecondaryColor }"
                                        HeightRequest="{ OnPlatform Android=30 }"
                                        FontSize="14"
                                        BackgroundColor="{ DynamicResource BackgroundColor }"
                                        Padding="8,6"
                                    />
                                </DataTemplate>
                            </grial:SelectableWrapPanel.ItemTemplate>

                            <grial:SelectableWrapPanel.SelectedItemTemplate>
                                <DataTemplate>
                                    <grial:RoundedLabel
                                        Text="{ Binding . }"
                                        TextColor="{ DynamicResource PrimaryActionButtonTextColor }"
                                        HeightRequest="{ OnPlatform Android=30 }"
                                        FontSize="14"
                                        BackgroundColor="{ DynamicResource PrimaryColor }"
                                        Padding="8,6"
                                    />
                                </DataTemplate>
                            </grial:SelectableWrapPanel.SelectedItemTemplate>
                        </grial:SelectableWrapPanel>

                        <!-- Single Days -->
                        <grial:SelectableWrapPanel
                            ItemsSource="{ Binding FrequencySingle }"
                            SelectedItems="{ Binding Days, Mode=TwoWay }"
                            SelectionMode="Multiple"
                            HorizontalOptions="Start"
                            ColumnSpacing="0">

                            <grial:SelectableWrapPanel.ItemTemplate>
                                <DataTemplate>
                                    <grial:RoundedLabel
                                        Text="{ Binding . }"
                                        TextColor="{ DynamicResource TextSecondaryColor }"
                                        HeightRequest="{ OnPlatform Android=30 }"
                                        FontSize="14"
                                        BackgroundColor="{ DynamicResource BackgroundColor }"
                                        Padding="8,6"
                                    />
                                </DataTemplate>
                            </grial:SelectableWrapPanel.ItemTemplate>
                            <grial:SelectableWrapPanel.SelectedItemTemplate>
                                <DataTemplate>
                                    <grial:RoundedLabel
                                        Text="{ Binding . }"
                                        TextColor="{ DynamicResource PrimaryActionButtonTextColor }"
                                        HeightRequest="{ OnPlatform Android=30 }"
                                        FontSize="14"
                                        BackgroundColor="{ DynamicResource PrimaryColor }"
                                        Padding="8,6"
                                    />
                                </DataTemplate>
                            </grial:SelectableWrapPanel.SelectedItemTemplate>
                        </grial:SelectableWrapPanel>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- FOOTER -->
            <Button
                Grid.Row="1"
                Margin="0,20,0,0"
                VerticalOptions="Start"
                HorizontalOptions="{ grial:OnOrientationLayoutOptions
                    Portrait=Fill,
                    Landscape=Center
                }"
                WidthRequest="300"
                Style="{ StaticResource PrimaryActionButtonStyle }"
                Text="{ grial:Translate StringAddSchedule }"
                Command="{ Binding SaveCommand }"
            />
        </Grid>
    </Grid>
</uxd:PopupPage>
