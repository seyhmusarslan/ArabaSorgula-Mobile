<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.TrafficInformationTemplate"
    x:Name="root">
    <Grid
        RowDefinitions="*,*"
        RowSpacing="0"
        ColumnDefinitions="45,*"
        ColumnSpacing="10">

        <!-- DISTANCE -->
        <local:RoundedIcon
            Grid.RowSpan="2"
            HeightRequest="45"
            WidthRequest="45"
            IsCircular="True"
            BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
            IconFontSize="22"
            IconColor="{ DynamicResource TextSecondaryColor }"
            IconFontFamily="{ StaticResource GrialIconsFill }"
            IconText="{ Binding IconText, Source={x:Reference root} }"
        />

        <!-- TITLE -->
        <Label
            Grid.Column="1"
            FontAttributes="Bold"
            Text="{ Binding Title, Source={x:Reference root} }"
            TextColor="{ DynamicResource TextSecondaryColor }"
            FontSize="16"
        />

        <!-- INFO -->
        <Label
            Grid.Column="1"
            Grid.Row="1"
            Text="{ Binding Description, Source={x:Reference root} }"
            TextColor="{ DynamicResource TextTertiaryColor }"
            FontSize="14"
        />
    </Grid>
</ContentView>
