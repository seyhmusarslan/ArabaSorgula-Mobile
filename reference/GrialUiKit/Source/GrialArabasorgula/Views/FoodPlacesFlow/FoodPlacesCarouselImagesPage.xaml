<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.FoodPlacesCarouselImagesPage"
    x:Name="Root">
    <Grid
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <CarouselView
            x:Name="carousel"
            BackgroundColor="#000"
            VerticalOptions="Fill"
            HorizontalOptions="Fill"
            ItemsSource="{ Binding . }"
            CurrentItem="{ Binding SelectedDish, Source={x:Reference Root} }">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Image
                        Source="{ Binding . }"
                        Aspect="AspectFit"
                    />
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- CLOSE BUTTON -->
        <local:RoundedIconButton
            Clicked="OnClose"
            Style="{ StaticResource CloseIconButtonStyle }"
        />
    </Grid>
</ContentPage>
