<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.ShippingDetailPage"
    BackgroundColor="{ DynamicResource BackgroundColor }"
    Title="{ grial:Translate PageTitleShippingDetail }">
    <ContentPage.Resources>
        <!-- Grid Styles -->
        <Style TargetType="grial:DataGrid">
            <Setter Property="SelectedBackgroundColor" Value="#40BFE1FF" />
            <Setter Property="HeaderRowBackgroundColor" Value="{ DynamicResource DataGridHeaderRowBackgroundColor }" />
            <Setter Property="BackgroundColor" Value="{ DynamicResource DataGridBackgroundColor }" />
            <Setter Property="GridSeparatorVisibility" Value="None" />
            <Setter Property="HeaderSeparatorVisibility" Value="None" />
            <Setter Property="EvenRowsBackgroundColor" Value="{ DynamicResource EvenRowsBackgroundColor }" />
        </Style>

        <!-- Column Styles -->
        <Style x:Key="BaseColumn" TargetType="grial:DataGridColumn">
            <Setter Property="IsSortable" Value="True" />
            <Setter Property="SortIconsFontFamily" Value="{ StaticResource IconsFontFamily }" />
            <Setter Property="DescendingSortIconText" Value="{ x:Static local:GrialIconsFont.ChevronDown }" />
            <Setter Property="AscendingSortIconText" Value="{ x:Static local:GrialIconsFont.ChevronUp }" />
            <Setter Property="ColumnWidth" Value="0.1*" />

            <Setter Property="HeaderTextColor" Value="{ DynamicResource DataGridHeaderTextColor }" />
            <Setter Property="HeaderTextAlignment" Value="Center" />
            <Setter Property="HeaderFontSize" Value="{ StaticResource BaseFontSize }" />
            <Setter Property="HeaderFontAttributes" Value="None" />
            <Setter Property="HeaderPadding" Value="2,14" />

            <Setter Property="CellTextColor" Value="{ DynamicResource DataGridCellTextColor }" />
            <Setter Property="CellPadding" Value="14" />
            <Setter Property="CellFontSize" Value="14" />
            <Setter Property="CellTextAlignment" Value="Center" />
            <Setter Property="CellVerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IdColumn" TargetType="grial:DataGridColumn" BasedOn="{ StaticResource BaseColumn }">
            <Setter Property="BindingPath" Value="Id" />
            <Setter Property="HeaderText" Value="Order ID" />
            <Setter Property="HeaderTextAlignment" Value="Start" />
            <Setter Property="HeaderPadding" Value="14" />
            <Setter Property="ColumnWidth" Value="120" />

            <Setter Property="CellTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <!-- ICON AND ID# -->
                            <local:EmojiText
                                Icon="{ grial:IfEval
                                    Expression='A == 1',
                                    A={Binding Progress},
                                    Then={x:Static local:Emojis.check_mark_button},
                                    Else={x:Static local:Emojis.delivery_truck}
                                }"
                                IconSize="22"
                                IconTranslationY="{ grial:Eval
                                    'A == 1 ? -2 : -3',
                                    A={Binding Progress}
                                }"
                                Text="{ Binding Id }"
                                TextFontAttributes="Bold"
                                VerticalOptions="Center"
                                Orientation="Horizontal"
                                Spacing="10"
                            />
                        </Grid>

                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressColumn" TargetType="grial:DataGridColumn" BasedOn="{ StaticResource BaseColumn }">
            <Setter Property="BindingPath" Value="Progress" />
            <Setter Property="HeaderText" Value="Progress" />
            <Setter Property="ColumnWidth" Value="85" />

            <Setter Property="CellTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ProgressBar
                            Progress="{ Binding Progress }"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill"
                        />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeColumn" TargetType="grial:DataGridColumn" BasedOn="{ StaticResource BaseColumn }">
            <Setter Property="BindingPath" Value="Closed" />
            <Setter Property="HeaderText" Value="Time" />
            <Setter Property="ColumnWidth" Value="80" />
            <Setter Property="BindingPath" Value="Time" />
            <Setter Property="CellTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="WeightColumn" TargetType="grial:DataGridColumn" BasedOn="{ StaticResource BaseColumn }">
            <Setter Property="BindingPath" Value="Score" />
            <Setter Property="HeaderText" Value="Weight" />
            <Setter Property="ColumnWidth" Value="70" />
            <Setter Property="BindingPath" Value="Weight" />
            <Setter Property="StringFormat" Value="{}{0} lb" />
            <Setter Property="CellTextAlignment" Value="Start" />
        </Style>

        <Style x:Key="PriceColumn" TargetType="grial:DataGridColumn" BasedOn="{ StaticResource BaseColumn }">
            <Setter Property="BindingPath" Value="Price" />
            <Setter Property="HeaderText" Value="Price" />
            <Setter Property="ColumnWidth" Value="90" />
            <Setter Property="StringFormat" Value="{}${0:0.00}" />
            <Setter Property="CellTextAlignment" Value="Start" />
            <Setter Property="CellTextColor" Value="{ DynamicResource SuccessColor }" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid
            RowDefinitions="Auto,*"
            BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
            Padding="0,20,0,0">

            <!-- CATEGORIES TABS -->
            <Grid
                HeightRequest="60"
                ColumnDefinitions="*,*,*"
                Margin="{ DynamicResource AirSpacingNoTop }"
                RadioButtonGroup.GroupName="tabs"
                RadioButtonGroup.SelectedValue="{ Binding State, Mode=TwoWay }"
                VerticalOptions="Fill"
                Padding="1"
                BackgroundColor="{ DynamicResource BackgroundColor }"
                grial:Effects.CornerRadius="{ DynamicResource BaseCornerRadius }">
                <RadioButton
                    ControlTemplate="{ StaticResource TabRadioButtonTemplate }"
                    Content="{ grial:Translate StringAll }"
                    Value="0"
                    IsChecked="True"
                />
                <RadioButton
                    Grid.Column="1"
                    ControlTemplate="{ StaticResource TabRadioButtonTemplate }"
                    Content="{ grial:Translate StringInTransit }"
                    Value="1"
                />
                <RadioButton
                    Grid.Column="2"
                    ControlTemplate="{ StaticResource TabRadioButtonTemplate }"
                    Content="{ grial:Translate StringClosed }"
                    Value="2"
                />
            </Grid>

            <grial:ExtendedGrid
                Grid.Row="1"
                Padding="0,20,0,0"
                BackgroundColor="{ DynamicResource DataGridHeaderRowBackgroundColor }"
                Margin="0,-40,0,0"
                TrimTopShape="InvertedRoundedCorners"
                TrimTopHeight="40">

                <!-- Data Grid -->
                <grial:DataGrid
                    Padding="0,0,0,20"
                    grial:Effects.ApplyIOSSafeAreaAsPadding="Left,Right"
                    RowHeight="60"
                    SelectionMode="Row"
                    HorizontalOptions="Center"
                    VerticalOptions="Fill"
                    ItemsSource="{ Binding Items }"
                    HeaderRowBackgroundColor="{ DynamicResource DataGridHeaderRowBackgroundColor }"
                    EvenRowsBackgroundColor="{ DynamicResource EvenRowsBackgroundColor }"
                    OddRowsBackgroundColor="{ DynamicResource OddRowsBackgroundColor }"
                    BackgroundColor="{ DynamicResource DataGridBackgroundColor }"
                    EnableHorizontalScrolling="True">
                    <grial:DataGrid.ColumnDefinitions>
                        <grial:DataGridColumn Style="{ StaticResource IdColumn }" />
                        <grial:DataGridColumn Style="{ StaticResource ProgressColumn }" />
                        <grial:DataGridColumn Style="{ StaticResource TimeColumn }" />
                        <grial:DataGridColumn Style="{ StaticResource WeightColumn }" />
                        <grial:DataGridColumn Style="{ StaticResource PriceColumn }" />
                    </grial:DataGrid.ColumnDefinitions>
                </grial:DataGrid>

            </grial:ExtendedGrid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
