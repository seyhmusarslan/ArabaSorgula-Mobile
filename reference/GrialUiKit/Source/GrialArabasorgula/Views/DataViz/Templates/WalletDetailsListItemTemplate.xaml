<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="arabasorgula.WalletDetailsListItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula">
    <ContentView.Resources>
        <!-- Converter -->
        <grial:LessThanZeroConverter
            x:Key="NegativeToErrorColorConverter"
            x:TypeArguments="Color"
            FalseValue="{ StaticResource SuccessColor }"
            TrueValue="{ StaticResource ErrorColor }"
        />
    </ContentView.Resources>

    <Grid
        Margin="0,10"
        ColumnDefinitions="40,*,Auto"
        ColumnSpacing="12"
        RowDefinitions="Auto,Auto,Auto">
        <!-- Icon -->
        <local:RoundedIcon
            Grid.RowSpan="2"
            CornerRadius="{ DynamicResource CornerRadius-md }"
            HeightRequest="40"
            HorizontalOptions="Center"
            IconBackgroundColor="{ Binding BackgroundColorColor }"
            IconBackgroundOpacity="0.1"
            IconColor="{ Binding BackgroundColorColor }"
            IconFontSize="20"
            IconText="{ Binding Icon }"
            VerticalOptions="Center"
            WidthRequest="40"
        />
        <!-- Item -->
        <Label
            Grid.Row="0"
            Grid.Column="1"
            FontSize="{ StaticResource LargeFontSize }"
            HorizontalTextAlignment="Start"
            Text="{ Binding Item }"
            TextColor="{ DynamicResource TextColor }"
            VerticalTextAlignment="Center"
        />
        <!-- Place -->
        <Label
            Grid.Row="1"
            Grid.Column="1"
            FontSize="11"
            HorizontalTextAlignment="Start"
            Text="{ Binding Category }"
            TextColor="{ DynamicResource TextSecondaryColor }"
            VerticalTextAlignment="Center"
        />
        <!-- Value -->
        <Label
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2"
            FontSize="{ StaticResource LargeFontSize }"
            HorizontalTextAlignment="End"
            Text="{ Binding Value, StringFormat='$ {0:0.##}' }"
            TextColor="{ Binding ValueDifference, Converter={StaticResource NegativeToErrorColorConverter} }"
            VerticalTextAlignment="Center"
        />
        <!-- Separator -->
        <BoxView
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            Style="{ StaticResource Horizontal1ptLineStyle }"
            VerticalOptions="End"
        />
    </Grid>
</ContentView>

