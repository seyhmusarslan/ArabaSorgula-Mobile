<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.WebsiteTrafficReportCardItemTemplate">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- Color Converter -->
            <grial:GreaterThanOrEqualConverter
                x:TypeArguments="Color"
                x:Key="ColorConverter"
                TrueValue="{ StaticResource SuccessColor }"
                FalseValue="{ StaticResource ErrorColor }"
            />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- DATA CARDS -->
    <Grid
        Grid.Row="1"
        ColumnDefinitions="*,*"
        ColumnSpacing="17">

        <!-- USERS CARD -->
        <grial:CardView
            Grid.Column="0"
            Padding="16"
            HasShadow="False"
            RowDefinitions="*,Auto,Auto"
            BindingContext="{ Binding Users }">

            <!-- Icon -->
            <local:RoundedIcon
                IconBackgroundColor="{ DynamicResource PrimaryVariantColor }"
                IconBackgroundCornerRadius="{ DynamicResource CornerRadius-md }"
                HeightRequest="40"
                WidthRequest="40"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                IconText="{ Binding Icon }"
                IconFontFamily="{ StaticResource IconsFontFamily }"
                IconColor="{ DynamicResource PrimaryColor }"
                IconFontSize="20"
            />

            <!-- Stats Container -->
            <HorizontalStackLayout
                Grid.Row="1"
                Spacing="8"
                HorizontalOptions="Start">
                <!-- Amount -->
                <Label
                    Text="{ Binding Value }"
                    FontSize="{ StaticResource TitleFontSize }"
                    VerticalTextAlignment="Center"
                />
                <!-- Icon -->
                <Label
                    Text="{ x:Static local:GrialIconsFont.ArrowUpRight }"
                    FontFamily="{ StaticResource GrialIconsFill }"
                    FontSize="10"
                    TextColor="{ Binding Difference, Converter={StaticResource ColorConverter} }"
                    VerticalTextAlignment="Center"
                />
                <!-- Percentage -->
                <Label
                    Text="{ Binding Percentage }"
                    FontSize="10"
                    TextColor="{ DynamicResource TextSecondaryColor }"
                    VerticalTextAlignment="Center"
                />
            </HorizontalStackLayout>

            <!-- ID -->
            <Label
                Grid.Row="2"
                FontSize="11"
                HorizontalTextAlignment="Start"
                Text="{ Binding ID }"
                VerticalTextAlignment="Center"
            />

        </grial:CardView>

        <!-- SESSIONS CARD -->
        <grial:CardView
            Grid.Column="1"
            Padding="16"
            HasShadow="False"
            RowDefinitions="*,Auto,Auto"
            BindingContext="{ Binding Sessions }">

            <!-- Icon -->
            <local:RoundedIcon
                IconBackgroundColor="#5E39CE"
                IconBackgroundOpacity=".1"
                IconBackgroundCornerRadius="{ DynamicResource CornerRadius-md }"
                HeightRequest="40"
                WidthRequest="40"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                IconText="{ Binding Icon }"
                IconFontFamily="{ StaticResource IconsFontFamily }"
                IconColor="#5E39CE"
                IconFontSize="20"
            />

            <!-- Stats Container -->
            <HorizontalStackLayout
                Grid.Row="1"
                Spacing="8"
                HorizontalOptions="Start">
                <!-- Amount -->
                <Label
                    Text="{ Binding Value }"
                    FontSize="{ StaticResource TitleFontSize }"
                    VerticalTextAlignment="Center"
                />
                <!-- Icon -->
                <Label
                    Text="{ x:Static local:GrialIconsFont.ArrowDownRight }"
                    FontFamily="{ StaticResource GrialIconsFill }"
                    FontSize="10"
                    TextColor="{ Binding Difference, Converter={StaticResource ColorConverter} }"
                    VerticalTextAlignment="Center"
                />
                <!-- Percentage -->
                <Label
                    Text="{ Binding Percentage }"
                    FontSize="10"
                    TextColor="{ DynamicResource TextSecondaryColor }"
                    VerticalTextAlignment="Center"
                />
            </HorizontalStackLayout>

            <!-- ID -->
            <Label
                Grid.Row="2"
                FontSize="11"
                HorizontalTextAlignment="Start"
                Text="{ Binding ID }"
                VerticalTextAlignment="Center"
            />

        </grial:CardView>

    </Grid>
</ContentView>

