<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="arabasorgula.WalletAmountsCardItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula">
    <Grid
        Margin="0,0,0,10"
        ColumnDefinitions="*,*"
        ColumnSpacing="32">

        <!-- INCOME -->
        <grial:CardView
            Grid.Column="0"
            Margin="-10"
            Padding="10"
            ColumnDefinitions="40,*"
            ColumnSpacing="12"
            CornerRadius="{ DynamicResource CornerRadius-md }"
            HasShadow="False"
            RowDefinitions="Auto,Auto">

            <!-- Icon -->
            <local:RoundedIcon
                Grid.RowSpan="2"
                CornerRadius="{ DynamicResource CornerRadius-md }"
                HeightRequest="40"
                HorizontalOptions="Center"
                IconBackgroundColor="{ DynamicResource SuccessColor }"
                IconBackgroundOpacity="0.1"
                IconColor="{ DynamicResource SuccessColor }"
                IconFontFamily="{ StaticResource GrialIconsFill }"
                IconFontSize="20"
                IconText="{ x:Static local:GrialIconsFont.ArrowDown }"
                VerticalOptions="Center"
                WidthRequest="40"
            />

            <!-- Value -->
            <Label
                Grid.Row="0"
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="{ StaticResource LargeFontSize }"
                HorizontalTextAlignment="Start"
                Text="{ Binding Income }"
                TextColor="{ DynamicResource TextColor }"
                VerticalTextAlignment="Center"
            />

            <!-- Label -->
            <Label
                Grid.Row="1"
                Grid.Column="1"
                FontSize="11"
                HorizontalTextAlignment="Start"
                Text="{ grial:Translate StringIncome }"
                TextColor="{ DynamicResource TextSecondaryColor }"
                VerticalTextAlignment="Center"
            />
        </grial:CardView>

        <!-- EXPENSES -->
        <grial:CardView
            Grid.Column="1"
            Margin="-10"
            Padding="10"
            ColumnDefinitions="40,*"
            ColumnSpacing="12"
            CornerRadius="{ DynamicResource CornerRadius-md }"
            HasShadow="False"
            RowDefinitions="Auto,Auto">


            <!-- Icon -->
            <local:RoundedIcon
                Grid.RowSpan="2"
                CornerRadius="{ DynamicResource CornerRadius-md }"
                HeightRequest="40"
                HorizontalOptions="Center"
                IconBackgroundColor="{ DynamicResource ErrorColor }"
                IconBackgroundOpacity="0.1"
                IconColor="{ DynamicResource ErrorColor }"
                IconFontFamily="{ StaticResource GrialIconsFill }"
                IconFontSize="20"
                IconText="{ x:Static local:GrialIconsFont.ArrowUp }"
                VerticalOptions="Center"
                WidthRequest="40"
            />

            <!-- Value -->
            <Label
                Grid.Row="0"
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="{ StaticResource LargeFontSize }"
                HorizontalTextAlignment="Start"
                Text="{ Binding Expenses }"
                TextColor="{ DynamicResource TextColor }"
                VerticalTextAlignment="Center"
            />

            <!-- Label -->
            <Label
                Grid.Row="1"
                Grid.Column="1"
                FontSize="11"
                HorizontalTextAlignment="Start"
                Text="{ grial:Translate StringExpenses }"
                TextColor="{ DynamicResource TextSecondaryColor }"
                VerticalTextAlignment="Center"
            />
        </grial:CardView>
    </Grid>
</ContentView>

