<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.TasksOverviewListItemTemplate">
    <ContentView.Resources>
        <ResourceDictionary>
            <grial:GreaterThanOrEqualConverter
                x:TypeArguments="Color"
                x:Key="ColorConverter"
                TrueValue="{ StaticResource SuccessColor }"
                FalseValue="{ StaticResource ErrorColor }"
            />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid
            Margin="0,5"
            Padding="{ DynamicResource AirSpacingNoBorder }"
            ColumnSpacing="10"
            ColumnDefinitions="45,*,40,70">

            <!-- AVATAR -->
            <grial:RoundedImage
                Grid.Column="0"
                Style="{ StaticResource AvatarImageStyle }"
                Source="{ Binding Avatar }"
                VerticalOptions="Center"
                HorizontalOptions="Start"
                Size="40"
            />

            <!-- TEXT -->
            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center"
                Spacing="0">
                <Label
                    Text="{ Binding Name }"
                    FontAttributes="Bold"
                />
                <Label
                    Text="{ Binding Division, Converter={StaticResource ToUpperConverter} }"
                    FontSize="10"
                    Opacity="0.5"
                />
            </VerticalStackLayout>

            <grial:CategoryChart
                Grid.Column="2"
                Margin="-5,0"
                BackgroundColor="Transparent"
                DisplayLabels="False"
                HeightRequest="15"
                WidthRequest="40"
                DisplayValuesAxis="False"
                DisplayReferenceAxis="False"
                VerticalOptions="Center">

                <grial:LineSeries
                    ItemsSource="{ Binding Evolution }"
                    Color="{ Binding Change, Converter={StaticResource ColorConverter} }"
                    DisplayPoints="False"
                    FillPoints="False"
                    LineStrokeSize="1"
                />
            </grial:CategoryChart>

            <!-- CHANGE -->
            <Label
                Grid.Column="3"
                Text="{ Binding Change, StringFormat='{}{0}%' }"
                TextColor="{ Binding Change, Converter={StaticResource ColorConverter} }"
                FontSize="{ StaticResource BaseFontSize }"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                FontAttributes="Bold"
            />

        </Grid>
    </ContentView.Content>
</ContentView>
