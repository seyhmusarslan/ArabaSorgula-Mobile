<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.TaskOverviewCardItemTemplate">
    <ContentView.Content>
        <grial:CardView
            Grid.Column="0"
            Padding="16,14"
            HasShadow="False"
            BackgroundColor="{ DynamicResource BackgroundColor }"
            RowDefinitions="Auto,*">

            <!-- Title -->
            <Label
                Grid.Row="0"
                Text="{ Binding Title }"
                FontSize="12"
            />

            <!-- Chart -->
            <grial:CategoryChart
                Grid.Row="1"
                Margin="-20,0,-20,-20"
                BackgroundColor="Transparent"
                DisplayLabels="False"
                HeightRequest="100"
                DisplayValuesAxis="False"
                DisplayReferenceAxis="False"
                VerticalOptions="End">

                <grial:LineSeries
                    ItemsSource="{ Binding Evolution }"
                    Color="{ DynamicResource FavoriteColor }"
                    DisplayPoints="False"
                    AreaBrush="#1Aff4500"
                    LineStrokeSize="2"
                />
            </grial:CategoryChart>

            <!-- Value -->
            <Label
                Grid.Row="1"
                Text="{ Binding Total }"
                FontSize="40"
                TextColor="{ DynamicResource TextColor }"
            />

        </grial:CardView>
    </ContentView.Content>
</ContentView>
