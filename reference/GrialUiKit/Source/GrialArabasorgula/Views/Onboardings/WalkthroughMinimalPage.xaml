<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.WalkthroughMinimalPage"
    xmlns:local="clr-namespace:arabasorgula"
    BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
    grial:GrialNavigationPage.HasNavigationBar="False">

    <grial:Carousel
        x:Name="carousel"
        VerticalOptions="Fill"
        Loop="False"
        Position="{ Binding Position, Mode=TwoWay }"
        ItemsSource="{ Binding Items }"
        MoveNextCommand="{ Binding MoveNextCommand }">
        <grial:Carousel.ItemTemplate>
            <DataTemplate>
                <local:WalkthroughMinimalItemTemplate
                    Header="{ Binding Header }"
                    Text="{ Binding Text }"
                    IconText="{ Binding IconText }"
                    IconColor="{ Binding IconColorColor }"
                    ButtonText="{ Binding ButtonText }"
                    CloseCommand="{ Binding BindingContext.CloseCommand, Source={x:Reference carousel} }"
                    ActionButtonCommand="{ Binding BindingContext.ActionButtonCommand, Source={x:Reference carousel} }"
                />
            </DataTemplate>
        </grial:Carousel.ItemTemplate>
    </grial:Carousel>
</ContentPage>