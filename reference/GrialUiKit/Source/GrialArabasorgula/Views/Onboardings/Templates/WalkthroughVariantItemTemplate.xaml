<?xml version="1.0" encoding="utf-8" ?>
<local:WalkthroughBaseItemTemplate
    x:Class="arabasorgula.WalkthroughVariantItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Name="Root">
    <local:WalkthroughBaseItemTemplate.Resources>
        <ResourceDictionary>
            <!-- OVERLAY GRADIENT -->
            <grial:LinearGradient x:Key="StepTemplateGradient" Angle="180">
                <grial:GradientColor Color="#00000000" />
                <grial:GradientColor Color="#77000000" />
            </grial:LinearGradient>

            <!-- ANIM IN -->
            <grial:AnimationStoryboard
                x:Key="AnimIn"
                Delay="200">
                <grial:AnimationFadeTo
                    Target="{ x:Reference iconLabel }"
                    Duration="300"
                    Opacity="1"
                />

                <grial:AnimationFadeTo
                    Target="{ x:Reference image }"
                    Duration="100"
                    Opacity="1"
                />

                <grial:AnimationScaleTo
                    Target="{ x:Reference image }"
                    Delay="100"
                    Duration="100"
                    Scale="1"
                />

                <grial:AnimationPopIn
                    Target="{ x:Reference headerLabel }"
                    Delay="200"
                    Duration="200"
                />

                <grial:AnimationRotateIn
                    Target="{ x:Reference headerLabel }"
                    Delay="200"
                    Duration="200"
                />

                <grial:AnimationFadeTo
                    Target="{ x:Reference descriptionLabel }"
                    Opacity="1"
                    Delay="300"
                    Duration="200"
                />
            </grial:AnimationStoryboard>


            <!-- ANIM RESET -->
            <grial:AnimationStoryboard x:Key="AnimReset">
                <grial:AnimationReset
                    Target="{ x:Reference iconLabel }"
                    Opacity="0"
                />

                <grial:AnimationReset
                    Target="{ x:Reference image }"
                    Opacity="0"
                    Scale="1.10"
                />

                <grial:AnimationReset
                    Target="{ x:Reference headerLabel }"
                    Opacity="0"
                />

                <grial:AnimationReset
                    Target="{ x:Reference descriptionLabel }"
                    Opacity="0"
                />
            </grial:AnimationStoryboard>
        </ResourceDictionary>
    </local:WalkthroughBaseItemTemplate.Resources>

    <local:WalkthroughBaseItemTemplate.Triggers>

        <EventTrigger Event="ItemInitialized">
            <grial:StartAnimation Animation="{ StaticResource AnimReset }" />
        </EventTrigger>

        <EventTrigger Event="ItemDisappearing">
            <grial:StartAnimation Animation="{ StaticResource AnimReset }" />
        </EventTrigger>

        <EventTrigger Event="ItemAppearing">
            <grial:StartAnimation Animation="{ StaticResource AnimIn }" />
        </EventTrigger>
    </local:WalkthroughBaseItemTemplate.Triggers>

    <local:WalkthroughBaseItemTemplate.Content>
        <Grid
            Margin="{ StaticResource CarouselViewItemFix }"
            grial:Effects.BackgroundGradient="{ StaticResource StepTemplateGradient }">

            <!-- BACKGROUND IMAGE -->
            <Image
                x:Name="image"
                Aspect="AspectFit"
                Source="{ Binding Source={x:Reference Root}, Path=StepBackgroundImage }"
                Margin="{ grial:OnOrientationThickness
                    PortraitPhone='70,0,70,0',
                    Landscape=0
                }"
                VerticalOptions="Center"
                Style="{ StaticResource NoPlaceholderImageStyle }"
                HeightRequest="{ grial:OnOrientationSizeRequest PortraitTablet=500 }"
            />

            <Grid RowDefinitions="*,Auto">

                <!-- CONTENT -->
                <VerticalStackLayout
                    VerticalOptions="Center"
                    Grid.Row="0"
                    Padding="60,0,60,40"
                    HeightRequest="-1"
                    Spacing="10">

                    <!-- ICON -->
                    <Label
                        x:Name="iconLabel"
                        Style="{ StaticResource WalkthroughStepIconStyle }"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{ Binding Source={x:Reference Root}, Path=IconText }"
                    />

                    <!-- HEADER -->
                    <Label
                        x:Name="headerLabel"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        BackgroundColor="Transparent"
                        TextColor="{ DynamicResource OnSurfaceColor }"
                        FontSize="30"
                        FontAttributes="Bold"
                        Text="{ Binding Source={x:Reference Root}, Path=Header }"
                    />

                    <!-- TEXT -->
                    <Label
                        x:Name="descriptionLabel"
                        Text="{ Binding Source={x:Reference Root}, Path=Text }"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"
                        BackgroundColor="Transparent"
                        TextColor="{ DynamicResource OnSurfaceColor }"
                        FontSize="12"
                        Margin="40,0"
                    />

                </VerticalStackLayout>


                <!-- BUTTON -->
                <Button
                    Grid.Row="1"
                    Style="{ StaticResource SecondaryActionButtonStyle }"
                    x:Name="actionButton"
                    TextColor="{ DynamicResource OnSurfaceColor }"
                    Text="{ Binding Source={x:Reference Root}, Path=ButtonText }"
                    BackgroundColor="{ Binding Source={x:Reference Root}, Path=ButtonBackgroundColor }"
                    Command="{ Binding ActionButtonCommand, Source={x:Reference Root} }"
                    Margin="{ DynamicResource AirSpacingNoTop }"
                    WidthRequest="{ grial:OnOrientationSizeRequest
                        LandscapePhone=200,
                        LandscapeTablet=400
                    }"
                    HorizontalOptions="{ grial:OnOrientationLayoutOptions
                        PortraitPhone=Fill,
                        LandscapePhone=Center,
                        PortraitTablet=Fill,
                        LandscapeTablet=Center
                    }"
                />

            </Grid>

            <!-- COSE BUTTON -->
            <local:RoundedIconButton
                Style="{ StaticResource CloseIconButtonStyle }"
                Command="{ Binding CloseCommand, Source={x:Reference Root} }"
            />

        </Grid>
    </local:WalkthroughBaseItemTemplate.Content>
</local:WalkthroughBaseItemTemplate>
