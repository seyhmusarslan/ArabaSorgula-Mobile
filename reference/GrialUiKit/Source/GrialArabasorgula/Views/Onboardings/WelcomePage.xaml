<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="arabasorgula.WelcomePage"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    grial:GrialNavigationPage.HasNavigationBar="false"
    Title="{ grial:Translate PageTitleWelcome }"
    BackgroundColor="{ DynamicResource BackgroundSecondaryColor }">
    <Grid
        Padding="{ DynamicResource AirSpacing }"
        Style="{ StaticResource ResponsiveLandscapeMarginStyle }"
        RowDefinitions="Auto,*,Auto">

        <!-- LOGO -->
        <Grid
            Margin="{ grial:OnOrientationThickness
                Portrait='0,70,0,0',
                Landscape='0'
            }"
            HorizontalOptions="Start"
            RowDefinitions="Auto,Auto"
            RowSpacing="15">

            <local:BrandLogo
                HorizontalOptions="Start"
                Inverted="False"
            />

            <Label
                HorizontalOptions="Start"
                Grid.Row="1"
                FontSize="24"
                Text="{ grial:Translate StringGrialUIKit }"
                FontAttributes="Bold"
            />
        </Grid>

        <!-- CLAIM TEXT -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="12"
            IsVisible="{ grial:OnOrientationBool
                Default=True,
                LandscapePhone=False
            }"
            Margin="0,40,0,0"
            VerticalOptions="Start">

            <Label
                LineBreakMode="WordWrap"
                Text="{ grial:Translate StringReadyMadeUIsForXamarin }"
                TextColor="{ DynamicResource TextColor }"
                VerticalTextAlignment="Center"
                FontAttributes="Bold"
                FontSize="{ OnIdiom
                    Phone=24,
                    Tablet=34
                }"
            />

            <Label
                LineBreakMode="WordWrap"
                Text="{ grial:Translate LabelTakeYourAppToNextLevel }"
                TextColor="{ DynamicResource PrimaryColor }"
                VerticalTextAlignment="Start"
                FontSize="{ OnIdiom
                    Phone=15,
                    Tablet=25
                }"
                IsVisible="{ grial:OnOrientationBool
                    Default=true,
                    LandscapePhone=false
                }"
            />

            <!-- VERSION TAG -->
            <grial:RoundedLabel
                FontSize="10"
                BackgroundColor="{ DynamicResource TagItemBackgroundColor }"
                HorizontalOptions="Start"
                Text="Version 4.0"
                Margin="-4,0"
            />
        </VerticalStackLayout>

        <!-- BUTTONS -->
        <VerticalStackLayout
            Grid.Row="2"
            VerticalOptions="End"
            HorizontalOptions="Fill"
            Spacing="15">

            <Button
                Clicked="OnWhatsNew"
                Style="{ StaticResource PrimaryActionButtonStyle }"
                Text="{ grial:Translate TakeWalkThrough }"
                VerticalOptions="End"
                WidthRequest="{ grial:OnOrientationSizeRequest LandscapeTablet=600 }"
                HorizontalOptions="{ grial:OnOrientationLayoutOptions
                    Portrait=Fill,
                    LandscapePhone=Fill,
                    LandscapeTablet=Center
                }"
            />

            <Button
                Clicked="OnClose"
                Style="{ StaticResource SecondaryActionButtonStyle }"
                Text="{ grial:Translate StringSkip }"
                VerticalOptions="End"
                WidthRequest="{ grial:OnOrientationSizeRequest LandscapeTablet=600 }"
                HorizontalOptions="{ grial:OnOrientationLayoutOptions
                    Portrait=Fill,
                    LandscapePhone=Fill,
                    LandscapeTablet=Center
                }"
            />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
