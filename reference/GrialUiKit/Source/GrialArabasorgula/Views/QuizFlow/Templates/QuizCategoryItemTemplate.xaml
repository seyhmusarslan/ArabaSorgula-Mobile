<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.QuizCategoryItemTemplate"
    x:Name="root">

    <!-- CONTAINER -->
    <Border
        BackgroundColor="{ DynamicResource BackgroundSecondaryColor }"
        StrokeShape="RoundRectangle 16"
        HeightRequest="64"
        WidthRequest="64">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{ Binding OnItemTappedCommand, Source={x:Reference root} }"
                CommandParameter="{ Binding . }"
            />
        </Border.GestureRecognizers>

        <!-- ICON -->
        <local:Emoji
            VerticalOptions="Center"
            HorizontalOptions="Center"
            HeightRequest="24"
            WidthRequest="24"
            Unicode="{ Binding Icon }"
        />
    </Border>

</ContentView>

