<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.PerformanceDashboardScorecardTemplate">
    <ContentView.Resources>
        <ResourceDictionary>
            <grial:GreaterThanZeroConverter
                x:TypeArguments="Color"
                x:Key="IndicatorColorConverter"
                TrueValue="{ StaticResource SuccessColor }"
                FalseValue="{ StaticResource ErrorColor }"
            />

            <grial:GreaterThanZeroConverter
                x:TypeArguments="Color"
                x:Key="IndicatorBackgroundColorConverter"
                TrueValue="{ StaticResource SuccessSecondaryColor }"
                FalseValue="{ StaticResource ErrorSecondaryColor }"
            />

            <grial:GreaterThanZeroConverter
                x:TypeArguments="x:String"
                x:Key="IndicatorIconConverter"
                TrueValue="{ x:Static local:GrialIconsFont.ShapeArrowUp }"
                FalseValue="{ x:Static local:GrialIconsFont.ShapeArrowDown }"
            />
        </ResourceDictionary>
    </ContentView.Resources>

    <ContentView.Content>
        <VerticalStackLayout Spacing="4">
            <!-- Name -->
            <Label
                Margin="0"
                FontSize="11"
                Text="{ Binding Name }"
                TextColor="{ DynamicResource TextTertiaryColor }"
                HorizontalOptions="Center"
            />

            <!-- Value -->
            <Label
                FontSize="18"
                FontAttributes="Bold"
                Text="{ Binding Value }"
                TextColor="{ DynamicResource TextColor }"
            />

            <Grid
                Margin="{ OnPlatform Android='0,-8,0,0' }"
                Padding="10,4"
                ColumnSpacing="4"
                ColumnDefinitions="Auto,*"
                HorizontalOptions="Start"
                BackgroundColor="{ Binding ValueDifference, Converter={StaticResource IndicatorBackgroundColorConverter} }"
                grial:Effects.CornerRadius="{ DynamicResource CornerRadius-sm }">
                <!-- Arrow -->
                <Label
                    Grid.Column="0"
                    FontSize="15"
                    VerticalTextAlignment="Center"
                    Text="{ Binding ValueDifference, Converter={StaticResource IndicatorIconConverter} }"
                    TextColor="{ Binding ValueDifference, Converter={StaticResource IndicatorColorConverter} }"
                    FontFamily="{ StaticResource IconsFontFamily }"
                />

                <!-- Value -->
                <Label
                    Grid.Column="1"
                    TextColor="{ Binding ValueDifference, Converter={StaticResource IndicatorColorConverter} }"
                    Text="{ Binding ValueDifference }"
                />
            </Grid>
        </VerticalStackLayout>
    </ContentView.Content>
</ContentView>
