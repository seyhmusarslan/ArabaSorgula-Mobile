<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.SamplesListPage"
    BackgroundColor="{ DynamicResource BackgroundColor }">
    <!-- CONTENT -->
    <Grid
        Grid.Row="0"
        RowSpacing="10"
        Style="{ StaticResource ResponsiveLandscapeMarginStyle }"
        RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Margin="30,35,30,0"
            ColumnSpacing="12"
            RowSpacing="0"
            ColumnDefinitions="Auto,*"
            RowDefinitions="Auto">

            <!-- TITLE -->
            <Label
                Grid.Column="0"
                FontSize="22"
                VerticalTextAlignment="Center"
                Text="{ Binding Title }"
                TextColor="{ DynamicResource TextColor }"
            />

            <!-- ICON -->
            <local:Emoji
                Grid.Column="1"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                WidthRequest="25"
                HeightRequest="25"
                Unicode="{ Binding Emoji }"
            />
        </Grid>

        <!-- LIST -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                BindableLayout.ItemsSource="{ Binding Samples }"
                Margin="0,10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <local:SamplesListItemTemplate>
                            <View.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </View.GestureRecognizers>
                        </local:SamplesListItemTemplate>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
