<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.BackgroundDecoration">
    <Grid
        x:Name="root"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <!-- BACK SHAPE -->
        <BoxView
            Color="White"
            Opacity=".08"
            CornerRadius="{ DynamicResource BackgroundDecorationCornerRadius }"
            Rotation="30"
            Scale="1.3"
            TranslationX="{ grial:Eval
                '0.55 * A',
                A={Binding
                    Width,
                    Source={x:Reference root}
                }
            }"
            TranslationY="{ grial:Eval
                '-0.3 * A',
                A={Binding
                    Height,
                    Source={x:Reference root}
                }
            }"
        />

        <!-- FRONT SHAPE -->
        <BoxView
            Color="White"
            Opacity=".08"
            CornerRadius="{ DynamicResource BackgroundDecorationCornerRadius }"
            Rotation="30"
            TranslationX="{ grial:Eval
                '0.6 * A',
                A={Binding
                    Width,
                    Source={x:Reference root}
                }
            }"
            TranslationY="{ grial:Eval
                '-0.2 * A',
                A={Binding
                    Height,
                    Source={x:Reference root}
                }
            }"
        />
    </Grid>
</ContentView>
