<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    x:Class="arabasorgula.Badge"
    x:Name="root">
    <Grid
        HorizontalOptions="Center"
        VerticalOptions="Center">
        <!-- Border -->
        <BoxView
            x:Name="border"
            IsVisible="False"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{ Binding BorderColor, Source={x:Reference root} }"
        />

        <!-- Badge -->
        <Border
            x:Name="indicator"
            HeightRequest="{ Binding Size, Source={x:Reference root} }"
            WidthRequest="{ Binding Size, Source={x:Reference root} }"
            BackgroundColor="{ Binding BackgroundColor, Source={x:Reference root} }"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Padding="0"
            Stroke="Transparent">

            <local:MinWidthLabel
                x:Name="label"
                MinWidth="{ Binding Size, Source={x:Reference root} }"
                TranslationY="{ Binding TextTranslationY, Source={x:Reference root} }"
                FontSize="{ Binding FontSize, Source={x:Reference root} }"
                Text="{ Binding Text, Source={x:Reference root} }"
                TextColor="{ Binding TextColor, Source={x:Reference root} }"
                FontFamily="{ Binding FontFamily, Source={x:Reference root} }"
                Margin="{ OnPlatform
                    Android='0,-3,0,0',
                    iOS='0,-1,0,0'
                }"
                FontAttributes="Bold"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"
            />
        </Border>
    </Grid>
</ContentView>
