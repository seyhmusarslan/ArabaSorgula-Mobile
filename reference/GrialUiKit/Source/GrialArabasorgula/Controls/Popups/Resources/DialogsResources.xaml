<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    xmlns:popups="clr-namespace:UXDivers.Popups.Maui.Controls;assembly=UXDivers.Popups.Maui"
    xmlns:uxd="clr-namespace:UXDivers.Popups.Maui;assembly=UXDivers.Popups.Maui"
    x:Class="arabasorgula.DialogsResources">

    <x:Boolean x:Key="DialogsCloseWhenBackgroundIsClicked">False</x:Boolean>

    <!-- UNITS -->
    <x:Double x:Key="DialogsIconsSize">24</x:Double>

    <!-- CUSTOM ACTION SHEET POSITIONING -->
    <LayoutOptions x:Key="CustomActionSheetPositioning">End</LayoutOptions>
    <x:Double x:Key="CustomActionSheetFontSize">16</x:Double>

    <!-- DIALOGS POSITIONING -->
    <LayoutOptions x:Key="DialogsVerticalPositioning">Center</LayoutOptions>

    <!-- SIMPLE DIALOGS -->
    <x:Boolean x:Key="DialogsIsSeparatorVisible">True</x:Boolean>
    <grial:XamlDoubleAlias x:Key="DialogsTitleFontSize" Value="{ StaticResource XLargeFontSize }" />
    <grial:XamlDoubleAlias x:Key="DialogsBodyFontSize" Value="{ StaticResource BaseFontSize }" />
    <Thickness x:Key="DialogsPadding">20</Thickness>

    <!-- NOTIFICATIONS -->
    <LayoutOptions x:Key="NotificationsVerticalPositioning">Start</LayoutOptions>
    <x:Double x:Key="NotificationsFontSize">14</x:Double>
    <x:Double x:Key="NotificationsIconSize">40</x:Double>
    <Thickness x:Key="NotificationsPadding">20</Thickness>

    <!-- CUSTOM ACTION SHEET -->
    <Style x:Key="CustomActionSheetListViewStyle" TargetType="ListView">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="SeparatorVisibility" Value="None" />
        <Setter Property="RowHeight" Value="55" />
    </Style>

    <Style x:Key="CustomActionSheetLabelStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{ DynamicResource CustomActionSheetTextColor }" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{ StaticResource CustomActionSheetFontSize }" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="CustomActionSheetIconStyle" TargetType="Label" BasedOn="{ StaticResource FontIcon }">
        <Setter Property="FontSize" Value="{ StaticResource CustomActionSheetFontSize }" />
        <Setter Property="TextColor" Value="{ DynamicResource CustomActionSheetTextColor }" />
    </Style>

    <Style x:Key="DialogPrimaryActionButtonStyle" TargetType="Button" BasedOn="{ StaticResource PrimaryActionButtonStyle }">
        <Setter Property="HeightRequest" Value="{ DynamicResource DialogsButtonHeightRequest }" />
        <Setter Property="CornerRadius" Value="{ DynamicResource DialogsButtonCornerRadius }" />
        <Setter Property="WidthRequest" Value="{ DynamicResource DialogsButtonWidthRequest }" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style x:Key="DialogOutlineInverseButtonStyle" TargetType="Button" BasedOn="{ StaticResource OutlineInverseButtonStyle }">
        <Setter Property="HeightRequest" Value="{ DynamicResource DialogsButtonHeightRequest }" />
        <Setter Property="CornerRadius" Value="{ DynamicResource DialogsButtonCornerRadius }" />
        <Setter Property="WidthRequest" Value="{ DynamicResource DialogsButtonWidthRequest }" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
</ResourceDictionary>