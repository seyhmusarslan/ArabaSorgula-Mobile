<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:arabasorgula"
    xmlns:grial="http://uxdivers.com/grial"
    grial:Effects.CornerRadius="{ Binding CornerRadius, Source={x:Reference Root} }"
    x:Class="arabasorgula.Tag"
    x:Name="Root">

    <Grid
        ColumnSpacing="0"
        ColumnDefinitions="Auto,Auto,Auto">

        <!-- IMAGE -->
        <grial:CircleImage
            Grid.Column="0"
            Margin="0,0,4,0"
            IsVisible="{ Binding Image, Source={x:Reference Root}, Converter={StaticResource IsNotNullConverter} }"
            Source="{ Binding Image, Source={x:Reference Root} }"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Size="{ Binding ImageSize, Source={x:Reference Root} }"
            BorderColor="{ Binding ImageBorderColor, Source={x:Reference Root} }"
            BorderSize="{ Binding ImageBorderSize, Source={x:Reference Root} }"
        />

        <!-- ICON -->
        <Label
            Grid.Column="1"
            IsVisible="{ Binding Icon, Source={x:Reference Root}, Converter={StaticResource IsNotEmptyStringConverter} }"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Style="{ StaticResource FontIcon }"
            Text="{ Binding Icon, Source={x:Reference Root} }"
            TextColor="{ Binding TextColor, Source={x:Reference Root} }"
            FontSize="{ Binding IconFontSize, Source={x:Reference Root} }"
        />

        <!-- TEXT -->
        <Label
            TextTransform="{ Binding TextTransform, Source={x:Reference Root} }"
            Grid.Column="2"
            Margin="4,0"
            VerticalOptions="Center"
            LineBreakMode="TailTruncation"
            FontSize="{ Binding FontSize, Source={x:Reference Root} }"
            Text="{ Binding Text, Source={x:Reference Root} }"
            TextColor="{ Binding TextColor, Source={x:Reference Root} }"
        />
    </Grid>
</ContentView>
