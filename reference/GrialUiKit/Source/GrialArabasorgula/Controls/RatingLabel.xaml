<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:grial="http://uxdivers.com/grial"
    x:Class="arabasorgula.RatingLabel"
    x:Name="Root">
    <ContentView.Content>
        <Grid
            ColumnSpacing="4"
            ColumnDefinitions="Auto,Auto">

            <grial:Rating
                IconColor="{ DynamicResource RatingColor }"
                Grid.Column="0"
                MaxValue="1"
                WidthRequest="20"
                HeightRequest="25"
                Value="1"
            />

            <Label
                Grid.Column="1"
                VerticalTextAlignment="Center"
                FontSize="{ StaticResource SmallTitleFontSize }"
                TextColor="{ DynamicResource RatingColor }"
                FontAttributes="Bold"
                Text="{ Binding Value, Source={x:Reference Root}, StringFormat='{0:0.0}' }"
            />
        </Grid>
    </ContentView.Content>
</ContentView>
