<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <StaticResource x:Key="AS.Color.Brand.Primary" Key="AS.Color.Raw.Brand.Primary" />
    <StaticResource x:Key="AS.Color.Brand.Mid" Key="AS.Color.Raw.Brand.Mid" />
    <StaticResource x:Key="AS.Color.Brand.Dark" Key="AS.Color.Raw.Brand.Dark" />
    <StaticResource x:Key="AS.Color.Brand.Gradient.Start" Key="AS.Color.Raw.Brand.Dark" />
    <StaticResource x:Key="AS.Color.Brand.Gradient.Middle" Key="AS.Color.Raw.Brand.Mid" />
    <StaticResource x:Key="AS.Color.Brand.Gradient.End" Key="AS.Color.Raw.Brand.Primary" />
    <StaticResource x:Key="AS.Color.Background.Primary" Key="AS.Color.Raw.Gray.50" />
    <StaticResource x:Key="AS.Color.Background.Secondary" Key="AS.Color.Raw.White" />
    <StaticResource x:Key="AS.Color.Surface.Primary" Key="AS.Color.Raw.White" />
    <StaticResource x:Key="AS.Color.Surface.Secondary" Key="AS.Color.Raw.Gray.50" />
    <StaticResource x:Key="AS.Color.Text.Primary" Key="AS.Color.Raw.Gray.950" />
    <StaticResource x:Key="AS.Color.Text.Secondary" Key="AS.Color.Raw.Gray.500" />
    <StaticResource x:Key="AS.Color.Text.OnBrand" Key="AS.Color.Raw.White" />
    <StaticResource x:Key="AS.Color.Border.Default" Key="AS.Color.Raw.Gray.200" />
    <StaticResource x:Key="AS.Color.Border.Subtle" Key="AS.Color.Raw.Gray.200" />

    <LinearGradientBrush
        x:Key="AS.Brush.Brand.VerticalGradient"
        StartPoint="0,0"
        EndPoint="0,1">
        <GradientStop Color="{DynamicResource AS.Color.Brand.Gradient.Start}" Offset="0.0" />
        <GradientStop Color="{DynamicResource AS.Color.Brand.Gradient.Middle}" Offset="0.45" />
        <GradientStop Color="{DynamicResource AS.Color.Brand.Gradient.End}" Offset="1.0" />
    </LinearGradientBrush>

    <x:Double x:Key="AS.Space.Xs">4</x:Double>
    <x:Double x:Key="AS.Space.Sm">8</x:Double>
    <x:Double x:Key="AS.Space.Md">12</x:Double>
    <x:Double x:Key="AS.Space.Lg">18</x:Double>
    <x:Double x:Key="AS.Space.Xl">24</x:Double>

    <x:Double x:Key="AS.Radius.Sm">6</x:Double>
    <x:Double x:Key="AS.Radius.Md">12</x:Double>
    <x:Double x:Key="AS.Radius.Lg">18</x:Double>

    <Thickness x:Key="AS.Inset.Button">18,12</Thickness>
    <Thickness x:Key="AS.Inset.Card">18</Thickness>
    <Thickness x:Key="AS.Inset.Badge">8,4</Thickness>
    <Thickness x:Key="AS.Inset.Tag">12,6</Thickness>
    <x:Double x:Key="AS.Size.TouchTarget.Minimum">48</x:Double>

    <x:String x:Key="AS.Type.FontFamily.Primary">Poppins</x:String>
    <x:String x:Key="AS.Type.FontFamily.Strong">PoppinsSemiBold</x:String>
    <x:Double x:Key="AS.Type.Caption">12</x:Double>
    <x:Double x:Key="AS.Type.Body">16</x:Double>
    <x:Double x:Key="AS.Type.BodyStrong">16</x:Double>
    <x:Double x:Key="AS.Type.Title">22</x:Double>
    <x:Double x:Key="AS.Type.Headline">28</x:Double>

    <x:String x:Key="AS.Icon.FontFamily">GrialIconsLine</x:String>
    <x:Double x:Key="AS.Icon.Size.Sm">16</x:Double>
    <x:Double x:Key="AS.Icon.Size.Md">20</x:Double>
    <x:Double x:Key="AS.Icon.Size.Lg">24</x:Double>

</ResourceDictionary>
