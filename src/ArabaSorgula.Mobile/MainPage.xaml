<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArabaSorgula.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource AS.Color.Background.Primary}">

    <Grid Padding="{StaticResource AS.Space.Xl}">
        <VerticalStackLayout
            HorizontalOptions="Center"
            Spacing="{StaticResource AS.Space.Sm}"
            VerticalOptions="Center">

            <Label
                FontFamily="{StaticResource AS.Type.FontFamily.Strong}"
                FontSize="{StaticResource AS.Type.Headline}"
                HorizontalTextAlignment="Center"
                Text="ArabaSorgula"
                TextColor="{DynamicResource AS.Color.Text.Primary}" />

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource AS.Style.Label.Body}"
                Text="Foundation hazır. Ürün geliştirmesi henüz başlamadı." />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
