<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ArabaSorgula.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource AS.Color.Background.Primary}">

    <Grid Padding="{StaticResource AS.Space.Xl}">
        <VerticalStackLayout
            HorizontalOptions="Center"
            Spacing="{StaticResource AS.Space.Md}"
            VerticalOptions="Center">

            <Border
                Padding="{StaticResource AS.Space.Lg}"
                BackgroundColor="{DynamicResource AS.Color.Brand.Primary}"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource AS.Radius.Lg}" />
                </Border.StrokeShape>

                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalTextAlignment="Center"
                    Text="ArabaSorgula"
                    TextColor="{DynamicResource AS.Color.Text.OnBrand}" />
            </Border>

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource AS.Style.Label.Body}"
                Text="Temel proje hazır. Grial UI Kit kaynaklarını reference/GrialUiKit/Source altına ekleyebilirsin." />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
