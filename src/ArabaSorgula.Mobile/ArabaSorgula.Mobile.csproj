<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>

        <OutputType>Exe</OutputType>
        <RootNamespace>ArabaSorgula.Mobile</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <ApplicationTitle>ArabaSorgula</ApplicationTitle>
        <ApplicationId>com.arabasorgula.mobile</ApplicationId>

        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg"
                  ForegroundFile="Resources\AppIcon\appiconfg.svg"
                  Color="#E31D1D" />

        <MauiSplashScreen Include="Resources\Splash\splash.svg"
                          Color="#E31D1D"
                          BaseSize="128,128" />

        <MauiImage Include="Resources\Images\*" />

        <MauiFont Include="Resources\Fonts\*" />

        <MauiAsset Include="Resources\Raw\**"
                   LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
        <PackageReference Include="UXDivers.GrialMaui" Version="4.4.127" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="GrialLicense" />
        <EmbeddedResource Include="GrialLicense"
                          LogicalName="ArabaSorgula.Mobile.GrialLicense" />
    </ItemGroup>

</Project>
